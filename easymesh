get_installed_core_version() {
    local core_path="/root/easytier/easytier-core"
    local version

    if [[ ! -x "$core_path" ]]; then
        printf 'not installed\n'
        return 0
    fi

    version=$("$core_path" --version 2>/dev/null | head -n 1)
    if [[ -n "$version" ]]; then
        printf '%s\n' "$version"
    else
        printf 'unknown\n'
    fi
}

get_service_status() {
    if [[ ! -f "$SERVICE_FILE" ]]; then
        printf 'missing\n'
    elif systemctl is-active --quiet easymesh.service; then
        printf 'active\n'
    else
        printf 'inactive\n'
    fi
}

get_running_core_version() {
    local pid
    local version

    if [[ "$(get_service_status)" != "active" ]]; then
        printf 'not running\n'
        return 0
    fi

    pid=$(systemctl show -p MainPID --value easymesh.service 2>/dev/null)
    if [[ ! "$pid" =~ ^[0-9]+$ ]] || [[ "$pid" == "0" ]] || [[ ! -x "/proc/$pid/exe" ]]; then
        printf 'not running\n'
        return 0
    fi

    version=$("/proc/$pid/exe" --version 2>/dev/null | head -n 1)
    if [[ -n "$version" ]]; then
        printf '%s\n' "$version"
    else
        printf 'unknown\n'
    fi
}

get_main_core_version() {
    printf '%s\n' "$MAIN_CORE_VERSION"
}

initialize_main_core_version() {
    MAIN_CORE_VERSION=$(get_binary_version_number /root/easytier/easytier-core 2>/dev/null || true)
    MAIN_CORE_VERSION=${MAIN_CORE_VERSION:-not-installed}
}

