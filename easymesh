# Function to add cron-tab job
add_cron_job() {
	local service_name="easymesh.service" temp_crontab restart_time time_choice
	local marker="# behify-easymesh-service-restart"
	echo
	
    # Prompt user to choose a restart time interval
    colorize cyan "Select the restart time interval:" bold
    echo
    echo "1. Every 30th minute"
    echo "2. Every 1 hour"
    echo "3. Every 2 hours"
    echo "4. Every 4 hours"
    echo "5. Every 6 hours"
    echo "6. Every 12 hours"
    echo "7. Every 24 hours"
    echo
    read -p "Enter your choice: " time_choice
    # Validate user input for restart time interval
    case $time_choice in
        1)
            restart_time="*/30 * * * *"
            ;;
        2)
            restart_time="0 * * * *"
            ;;
        3)
            restart_time="0 */2 * * *"
            ;;
        4)
            restart_time="0 */4 * * *"
            ;;
        5)
            restart_time="0 */6 * * *"
            ;;
        6)
            restart_time="0 */12 * * *"
            ;;
        7)
            restart_time="0 0 * * *"
            ;;
        *)
            echo -e "${RED}Invalid choice. Please enter a number between 1 and 7.${NC}\n"
            sleep 2
            return 1
            ;;
    esac


    command -v crontab >/dev/null 2>&1 || {
        colorize red "crontab is not installed; no maintenance job was changed." bold
        return 1
    }
    temp_crontab=$(mktemp) || return 1
    if crontab -l > "$temp_crontab" 2>/dev/null; then
        sed -i "/#easymesh\.service$/d; /# behify-easymesh-service-restart$/d" "$temp_crontab"
    else
        : > "$temp_crontab"
    fi
    printf '%s /bin/systemctl restart %s %s\n' "$restart_time" "$service_name" "$marker" >> "$temp_crontab"
    if ! crontab "$temp_crontab"; then
        rm -f "$temp_crontab"
        colorize red "Could not install the service restart schedule." bold
        return 1
    fi
    rm -f "$temp_crontab"
    
    echo
    colorize green "Cron-job added successfully to restart the service '$service_name'." bold
    sleep 2
}

delete_cron_job() {
    local service_name="easymesh.service" temp_crontab

    echo
    command -v crontab >/dev/null 2>&1 || {
        colorize yellow "crontab is not installed." bold
        return 0
    }
    temp_crontab=$(mktemp) || return 1
    if ! crontab -l > "$temp_crontab" 2>/dev/null; then
        rm -f "$temp_crontab"
        colorize yellow "No crontab is installed for this user." bold
        return 0
    fi
    sed -i "/#easymesh\.service$/d; /# behify-easymesh-service-restart$/d" "$temp_crontab"
    if ! crontab "$temp_crontab"; then
        rm -f "$temp_crontab"
        colorize red "Could not update crontab." bold
        return 1
    fi
    rm -f "$temp_crontab"
    colorize green "Cron job for $service_name deleted successfully." bold
    
    sleep 2
}

