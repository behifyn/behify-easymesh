#!/bin/bash

#color codes
GREEN="\033[0;32m"
CYAN="\033[0;36m"
WHITE="\033[1;37m"
RESET="\033[0m"
MAGENTA="\033[0;35m"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VERSION_FILE="$SCRIPT_DIR/versions.env"
RUNTIME_MANIFEST="$SCRIPT_DIR/manifest.txt"

if [[ ! -r "$VERSION_FILE" ]]; then
    printf 'Behify EasyMesh version metadata is missing: %s\n' "$VERSION_FILE" >&2
    exit 1
fi

# shellcheck source=versions.env
. "$VERSION_FILE"
if [[ ! "$BEHIFY_EASYMESH_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]] || \
   [[ ! "$EASYTIER_VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'Behify EasyMesh version metadata is invalid.\n' >&2
    exit 1
fi
readonly BEHIFY_EASYMESH_VERSION EASYTIER_VERSION
EASYTIER_VERSION_NUMBER="${EASYTIER_VERSION#v}"

show_usage() {
    printf '%s\n' \
        "Usage:" \
        "  sudo easymesh" \
        "  sudo easymesh --version" \
        "" \
        "Notes:" \
        "  EasyTier v2.6.4 is the only supported runtime." \
        "  Runtime installation and upgrades are handled by install.sh." \
        "  Encryption is enabled by default; disabling it requires confirmation." \
        "  Multi-thread mode is disabled by default." \
        "  IPv6 keeps the existing enabled-by-default behavior." \
        "" \
        "Runtime checks:" \
        "  /root/easytier/easytier-core --version" \
        "  PID=\$(systemctl show -p MainPID --value easymesh.service); sudo /proc/\$PID/exe --version"
}

if [[ $# -gt 0 ]]; then
    case "$1" in
        --help|-h)
            show_usage
            exit 0
            ;;
        --version)
            [[ $# -eq 1 ]] || {
                show_usage
                exit 1
            }
            printf 'Behify EasyMesh v%s\n' "$BEHIFY_EASYMESH_VERSION"
            printf 'EasyTier %s\n' "$EASYTIER_VERSION"
            exit 0
            ;;
        *)
            show_usage
            exit 1
            ;;
    esac
fi

# Check if the script is run as root
if [[ "${EASYMESH_SOURCE_ONLY:-0}" != "1" && $EUID -ne 0 ]]; then
   echo "This script must be run as root"
   sleep 1
   exit 1
fi


# just press key to continue
press_key(){
 read -p "Press Enter to continue..."
}


# Define a function to colorize text
colorize() {
    local color="$1"
    local text="$2"
    local style="${3:-normal}"
    
    # Define ANSI color codes
    local black="\033[30m"
    local red="\033[31m"
    local green="\033[32m"
    local yellow="\033[33m"
    local blue="\033[34m"
    local magenta="\033[35m"
    local cyan="\033[36m"
    local white="\033[37m"
    local reset="\033[0m"
    
    # Define ANSI style codes
    local normal="\033[0m"
    local bold="\033[1m"
    local underline="\033[4m"
    # Select color code
    local color_code
    case $color in
        black) color_code=$black ;;
        red) color_code=$red ;;
        green) color_code=$green ;;
        yellow) color_code=$yellow ;;
        blue) color_code=$blue ;;
        magenta) color_code=$magenta ;;
        cyan) color_code=$cyan ;;
        white) color_code=$white ;;
        *) color_code=$reset ;;  # Default case, no color
    esac
    # Select style code
    local style_code
    case $style in
        bold) style_code=$bold ;;
        underline) style_code=$underline ;;
        normal | *) style_code=$normal ;;  # Default case, normal text
    esac

    # Print the colored and styled text
    echo -e "${style_code}${color_code}${text}${reset}"
}

resolve_core_arch_directory() {
    local arch="${1:-$(uname -m)}"

    case "$arch" in
        x86_64|amd64)
            printf 'easytier-linux-x86_64\n'
            ;;
        aarch64|arm64)
            printf 'easytier-linux-aarch64\n'
            ;;
        *)
            return 1
            ;;
    esac
}

resolve_release_architecture() {
    local arch="${1:-$(uname -m)}"

    case "$arch" in
        x86_64|amd64) printf 'x86_64\n' ;;
        aarch64|arm64) printf 'aarch64\n' ;;
        *) return 1 ;;
    esac
}

get_binary_version_number() {
    local binary="$1"

    [[ -x "$binary" ]] || return 1
    "$binary" --version 2>/dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1
}

manifest_value() {
    local key="$1"

    [[ -f "$RUNTIME_MANIFEST" ]] || return 1
    awk -F= -v key="$key" '$1 == key { count++; value=substr($0, index($0, "=") + 1) } END { if (count != 1) exit 1; print value }' "$RUNTIME_MANIFEST"
}

verify_installed_runtime() {
    local architecture manifest_arch core_hash cli_hash actual_core_hash actual_cli_hash
    local core_version cli_version

    for required_command in uname awk sha256sum systemctl; do
        command -v "$required_command" >/dev/null 2>&1 || {
            printf 'Required command is missing: %s. Install it with your operating system package manager.\n' "$required_command" >&2
            return 1
        }
    done
    if [[ "$(uname -s)" != "Linux" ]]; then
        printf 'Unsupported operating system: %s. Behify EasyMesh v1 supports Linux only.\n' "$(uname -s)" >&2
        return 1
    fi
    if ! architecture=$(resolve_release_architecture); then
        printf 'Unsupported architecture: %s. Behify EasyMesh v1 supports only x86_64 and aarch64.\n' "$(uname -m)" >&2
        return 1
    fi
    if [[ ! -f /root/easytier/easytier-core || -L /root/easytier/easytier-core || ! -x /root/easytier/easytier-core ||
          ! -f /root/easytier/easytier-cli || -L /root/easytier/easytier-cli || ! -x /root/easytier/easytier-cli ]]; then
        printf 'EasyTier v2.6.4 is not installed. Run the verified Behify EasyMesh installer.\n' >&2
        return 1
    fi
    if [[ ! -f "$RUNTIME_MANIFEST" ]]; then
        printf 'Runtime manifest is missing: %s. Reinstall from a verified release package.\n' "$RUNTIME_MANIFEST" >&2
        return 1
    fi

    manifest_arch=$(manifest_value architecture) || return 1
    core_hash=$(manifest_value easytier_core_sha256) || return 1
    cli_hash=$(manifest_value easytier_cli_sha256) || return 1
    [[ "$manifest_arch" == "$architecture" ]] || {
        printf 'Installed package architecture mismatch: expected %s, found %s.\n' "$architecture" "$manifest_arch" >&2
        return 1
    }
    [[ "$core_hash" =~ ^[0-9a-f]{64}$ && "$cli_hash" =~ ^[0-9a-f]{64}$ ]] || return 1
    actual_core_hash=$(sha256sum /root/easytier/easytier-core | awk '{print $1}') || return 1
    actual_cli_hash=$(sha256sum /root/easytier/easytier-cli | awk '{print $1}') || return 1
    [[ "$actual_core_hash" == "$core_hash" && "$actual_cli_hash" == "$cli_hash" ]] || {
        printf 'Installed EasyTier files do not match the verified package manifest. Reinstall before continuing.\n' >&2
        return 1
    }

    core_version=$(get_binary_version_number /root/easytier/easytier-core) || return 1
    cli_version=$(get_binary_version_number /root/easytier/easytier-cli) || return 1
    [[ "$core_version" == "$EASYTIER_VERSION_NUMBER" && "$cli_version" == "$EASYTIER_VERSION_NUMBER" ]] || {
        printf 'Unsupported EasyTier runtime. Required: %s; core: %s; cli: %s.\n' \
            "$EASYTIER_VERSION" "${core_version:-unknown}" "${cli_version:-unknown}" >&2
        return 1
    }
}

generate_random_secret() {
    openssl rand -hex 16
}

#Var
EASY_CLIENT='/root/easytier/easytier-cli'
EASY_CORE='/root/easytier/easytier-core'
SERVICE_FILE="/etc/systemd/system/easymesh.service"
MESH_CONFIG_DIR="/etc/behify-easymesh"
MESH_ENV_FILE="$MESH_CONFIG_DIR/mesh.env"
MESH_CORE_CONFIG="$MESH_CONFIG_DIR/easytier.toml"
MAIN_CORE_VERSION=""

is_valid_ip_address() {
    command -v python3 >/dev/null 2>&1 &&
        python3 -c 'import ipaddress, sys; ipaddress.ip_address(sys.argv[1])' "$1" >/dev/null 2>&1
}

is_valid_hostname() {
    local value="$1"

    [[ ${#value} -ge 1 && ${#value} -le 253 ]] &&
        [[ "$value" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]]
}

is_valid_network_secret() {
    local value="$1"

    [[ ${#value} -ge 12 && ${#value} -le 128 ]] &&
        [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._~@+=,:/-]*$ ]]
}

trim_ascii_space() {
    local value="$1"

    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s\n' "$value"
}

build_peer_arguments() {
    local raw_addresses="$1" protocol="$2" port="$3"
    local address formatted
    local -a addresses processed

    PEER_ARGUMENTS=""
    [[ -n "$raw_addresses" ]] || return 0
    [[ ${#raw_addresses} -le 4096 ]] || return 1
    IFS=',' read -r -a addresses <<< "$raw_addresses"
    [[ ${#addresses[@]} -le 64 ]] || return 1
    for address in "${addresses[@]}"; do
        address=$(trim_ascii_space "$address")
        [[ -n "$address" ]] || return 1
        if [[ "$address" == \[*\] ]]; then
            address="${address:1:${#address}-2}"
        fi
        is_valid_ip_address "$address" || return 1
        if [[ "$address" == *:* ]]; then
            formatted="[$address]"
        else
            formatted="$address"
        fi
        processed+=("${protocol}://${formatted}:${port}")
    done
    PEER_ARGUMENTS="--peers ${processed[*]}"
}

write_mesh_environment() {
    local destination="$1"

    umask 077
    {
        printf 'EASYMESH_IP="%s"\n' "$IP_ADDRESS"
        printf 'EASYMESH_PEERS="%s"\n' "$PEER_ARGUMENTS"
        printf 'EASYMESH_HOSTNAME="%s"\n' "$HOSTNAME"
        printf 'EASYMESH_NETWORK_SECRET="%s"\n' "$NETWORK_SECRET"
        printf 'EASYMESH_DEFAULT_PROTOCOL="%s"\n' "$DEFAULT_PROTOCOL"
        printf 'EASYMESH_LISTENERS="%s"\n' "$LISTENERS"
        printf 'EASYMESH_MULTI_THREAD="%s"\n' "$MULTI_THREAD_OPTION"
        printf 'EASYMESH_ENCRYPTION="%s"\n' "$ENCRYPTION_OPTION"
        printf 'EASYMESH_IPV6="%s"\n' "$IPV6_OPTION"
    } > "$destination"
    chmod 0600 "$destination"
}

write_mesh_core_config() {
    local destination="$1"

    umask 077
    cat > "$destination" <<'EOF'
[network_identity]
network_name = "default"
network_secret = "${EASYMESH_NETWORK_SECRET}"
EOF
    chmod 0600 "$destination"
}

write_mesh_service() {
    local destination="$1"

    cat > "$destination" <<'EOF'
# Managed by Behify EasyMesh
[Unit]
Description=EasyMesh Network Service
After=network.target

[Service]
EnvironmentFile=/etc/behify-easymesh/mesh.env
ExecStart=/root/easytier/easytier-core --config-file /etc/behify-easymesh/easytier.toml --console-log-level warn -i ${EASYMESH_IP} $EASYMESH_PEERS --hostname ${EASYMESH_HOSTNAME} --default-protocol ${EASYMESH_DEFAULT_PROTOCOL} $EASYMESH_LISTENERS $EASYMESH_MULTI_THREAD $EASYMESH_ENCRYPTION $EASYMESH_IPV6
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$destination"
}

validate_staged_mesh_service() {
    local staged_service="$1" staged_config="${2:-}"

    if command -v systemd-analyze >/dev/null 2>&1; then
        systemd-analyze verify "$staged_service" >/dev/null 2>&1 || return 1
    else
        grep -Fqx 'EnvironmentFile=/etc/behify-easymesh/mesh.env' "$staged_service" &&
            grep -Fq -- '--config-file /etc/behify-easymesh/easytier.toml' "$staged_service" &&
            grep -Fq -- '--console-log-level warn' "$staged_service" &&
            grep -Fqx 'Restart=on-failure' "$staged_service" || return 1
    fi
    [[ -z "$staged_config" ]] ||
        EASYMESH_NETWORK_SECRET="$NETWORK_SECRET" "$EASY_CORE" \
            --config-file "$staged_config" --console-log-level warn --check-config >/dev/null 2>&1
}

mesh_configuration_paths_are_safe() {
    [[ ! -L "$MESH_CONFIG_DIR" && ! -L "$MESH_CONFIG_DIR/backups" &&
       ! -L "$MESH_ENV_FILE" && ! -L "$MESH_CORE_CONFIG" && ! -L "$SERVICE_FILE" ]] || return 1
    [[ ! -e "$MESH_CONFIG_DIR" || -d "$MESH_CONFIG_DIR" ]] || return 1
    [[ ! -e "$MESH_CONFIG_DIR/backups" || -d "$MESH_CONFIG_DIR/backups" ]] || return 1
    [[ ! -e "$MESH_ENV_FILE" || -f "$MESH_ENV_FILE" ]] || return 1
    [[ ! -e "$MESH_CORE_CONFIG" || -f "$MESH_CORE_CONFIG" ]] || return 1
    [[ ! -e "$SERVICE_FILE" || -f "$SERVICE_FILE" ]] || return 1
    [[ ! -f "$SERVICE_FILE" ]] || is_behify_mesh_service_file
}

restore_mesh_configuration() {
    local backup_dir="$1" service_existed="$2" env_existed="$3" config_existed="$4"
    local was_active="$5" was_enabled="$6"

    systemctl stop easymesh.service >/dev/null 2>&1 || true
    if [[ "$service_existed" == "1" ]]; then
        install -m 0644 "$backup_dir/easymesh.service" "$SERVICE_FILE" || return 1
    else
        rm -f "$SERVICE_FILE"
    fi
    if [[ "$env_existed" == "1" ]]; then
        install -m 0600 "$backup_dir/mesh.env" "$MESH_ENV_FILE" || return 1
    else
        rm -f "$MESH_ENV_FILE"
    fi
    if [[ "$config_existed" == "1" ]]; then
        install -m 0600 "$backup_dir/easytier.toml" "$MESH_CORE_CONFIG" || return 1
    else
        rm -f "$MESH_CORE_CONFIG"
    fi
    systemctl daemon-reload >/dev/null 2>&1 || return 1
    if [[ "$was_enabled" == "1" ]]; then
        systemctl enable easymesh.service >/dev/null 2>&1 || return 1
    else
        systemctl disable easymesh.service >/dev/null 2>&1 || true
    fi
    if [[ "$was_active" == "1" ]]; then
        systemctl start easymesh.service >/dev/null 2>&1 || return 1
    fi
}

activate_mesh_configuration() {
    local staged_env="$1" staged_config="$2" staged_service="$3"
    local backup_dir service_existed=0 env_existed=0 config_existed=0 was_active=0 was_enabled=0
    local new_env="$MESH_CONFIG_DIR/.mesh.env.new.$$"
    local new_config="$MESH_CONFIG_DIR/.easytier.toml.new.$$"
    local new_service="${SERVICE_FILE}.new.$$"

    mesh_configuration_paths_are_safe || {
        colorize red "Refusing to replace a symlinked path or an unrecognized easymesh.service." bold
        return 1
    }
    backup_dir=$(mktemp -d "$MESH_CONFIG_DIR/backups/mesh-$(date +%Y%m%d-%H%M%S).XXXXXX") || return 1
    chmod 0700 "$backup_dir"
    if [[ -f "$SERVICE_FILE" ]]; then
        service_existed=1
        cp -p "$SERVICE_FILE" "$backup_dir/easymesh.service" || return 1
    fi
    if [[ -f "$MESH_ENV_FILE" ]]; then
        env_existed=1
        cp -p "$MESH_ENV_FILE" "$backup_dir/mesh.env" || return 1
    fi
    if [[ -f "$MESH_CORE_CONFIG" ]]; then
        config_existed=1
        cp -p "$MESH_CORE_CONFIG" "$backup_dir/easytier.toml" || return 1
    fi
    systemctl is-active --quiet easymesh.service && was_active=1
    systemctl is-enabled --quiet easymesh.service && was_enabled=1

    if [[ "$was_active" == "1" ]] && ! systemctl stop easymesh.service >/dev/null 2>&1; then
        colorize red "Could not stop the existing mesh service. Configuration was not changed." bold
        return 1
    fi

    if ! install -m 0600 "$staged_env" "$new_env" ||
       ! install -m 0600 "$staged_config" "$new_config" ||
       ! install -m 0644 "$staged_service" "$new_service" ||
       ! mv -f "$new_env" "$MESH_ENV_FILE" ||
       ! mv -f "$new_config" "$MESH_CORE_CONFIG" ||
       ! chmod 0600 "$MESH_ENV_FILE" "$MESH_CORE_CONFIG" ||
       ! mv -f "$new_service" "$SERVICE_FILE" ||
       ! systemctl daemon-reload >/dev/null 2>&1 ||
       ! systemctl enable easymesh.service >/dev/null 2>&1 ||
       ! systemctl start easymesh.service >/dev/null 2>&1 ||
       ! systemctl is-active --quiet easymesh.service; then
        rm -f "$new_env" "$new_config" "$new_service"
        colorize red "Mesh configuration failed. Restoring the previous configuration and service state." bold
        if restore_mesh_configuration "$backup_dir" "$service_existed" "$env_existed" "$config_existed" "$was_active" "$was_enabled"; then
            colorize yellow "Previous mesh configuration restored." bold
        else
            colorize red "Rollback needs manual attention. Backup: $backup_dir" bold
        fi
        return 1
    fi

    colorize green "Behify EasyMesh Network Service Started." bold
    colorize green "Configuration backup: $backup_dir" bold
}

prompt_network_secret() {
    local generated_secret entered_secret

    if [[ "${EASYMESH_SOURCE_ONLY:-0}" != "1" ]] && { [[ ! -t 0 ]] || [[ ! -t 1 ]]; }; then
        colorize red "Network secret setup requires an interactive terminal." bold
        return 1
    fi
    generated_secret=$(generate_random_secret) || return 1
    printf 'Generated Network Secret:\n'
    colorize cyan "$generated_secret" bold
    read -r -p "Press Enter to use it, or enter a custom secret: " entered_secret || return 1
    NETWORK_SECRET=${entered_secret:-$generated_secret}
}

prompt_encryption_option() {
    local choice confirm

    colorize cyan "Encryption is enabled by default and recommended."
    read -r -p "[-] Enable EasyTier tunnel encryption? [Y/n]: " choice || return 1
    case "$choice" in
        ""|[Yy]*) ENCRYPTION_OPTION="" ;;
        [Nn]*)
            colorize yellow "Without EasyTier encryption, tunnel traffic is unencrypted. Use this only on trusted paths or for payloads already protected end to end." bold
            read -r -p "Disable EasyTier tunnel encryption? [y/N]: " confirm || return 1
            if [[ "$confirm" =~ ^[Yy] ]]; then
                ENCRYPTION_OPTION="--disable-encryption"
            else
                ENCRYPTION_OPTION=""
            fi
            ;;
        *) colorize red "Enter yes or no." bold; return 1 ;;
    esac
}

prompt_multi_thread_option() {
    local choice

    colorize cyan "Multi-thread can improve performance on some systems, but may increase instability or packet reordering on some paths."
    read -r -p "[-] Enable multi-thread mode? [y/N]: " choice || return 1
    case "$choice" in
        [Yy]*) MULTI_THREAD_OPTION="--multi-thread" ;;
        ""|[Nn]*) MULTI_THREAD_OPTION="" ;;
        *) colorize red "Enter yes or no." bold; return 1 ;;
    esac
}

connect_network_pool() {
    local PEER_ADDRESSES IP_ADDRESS HOSTNAME PORT NETWORK_SECRET
    local PROTOCOL_CHOICE DEFAULT_PROTOCOL ENCRYPTION_OPTION
    local MULTI_THREAD_OPTION IPV6_CHOICE IPV6_OPTION
    local PEER_ARGUMENTS LISTENERS staging_dir

    clear
    colorize cyan "Connect to the Mesh Network" bold
    echo
    colorize yellow "Tip: leave Peer blank for reverse mode; UDP is recommended."
    echo

    for required_command in python3 openssl; do
        command -v "$required_command" >/dev/null 2>&1 || {
            colorize red "$required_command is required for safe mesh configuration." bold
            press_key
            return 1
        }
    done
    read -r -p "[-] Enter Peer IPv4/IPv6 Addresses (separate multiple addresses by ','): " PEER_ADDRESSES || return 1
    read -r -p "[*] Enter Local IPv4/IPv6 Address (e.g., 10.144.144.1): " IP_ADDRESS || return 1
    is_valid_ip_address "$IP_ADDRESS" || {
        colorize red "Local address must be a valid IPv4 or IPv6 address." bold
        press_key
        return 1
    }
    read -r -p "[*] Enter Hostname (e.g., server-1): " HOSTNAME || return 1
    is_valid_hostname "$HOSTNAME" || {
        colorize red "Hostname must contain only letters, digits, dots, underscores, or hyphens." bold
        press_key
        return 1
    }
    read -r -p "[-] Enter Tunnel Port (Default 2090): " PORT || return 1
    PORT=${PORT:-2090}
    is_integer_in_range "$PORT" 1 65535 || {
        colorize red "Tunnel port must be an integer from 1 to 65535." bold
        press_key
        return 1
    }

    prompt_network_secret || return 1
    is_valid_network_secret "$NETWORK_SECRET" || {
        colorize red "Secret must be 12-128 safe characters and start with a letter or digit." bold
        press_key
        return 1
    }

    colorize green "[-] Select Default Protocol:" bold
    printf '%s\n' '1) tcp' '2) udp' '3) ws' '4) wss'
    read -r -p "[*] Select your desired protocol (1-4): " PROTOCOL_CHOICE || return 1
    case "$PROTOCOL_CHOICE" in
        1) DEFAULT_PROTOCOL="tcp" ;;
        2) DEFAULT_PROTOCOL="udp" ;;
        3) DEFAULT_PROTOCOL="ws" ;;
        4) DEFAULT_PROTOCOL="wss" ;;
        *) colorize red "Invalid protocol choice." bold; press_key; return 1 ;;
    esac
    build_peer_arguments "$PEER_ADDRESSES" "$DEFAULT_PROTOCOL" "$PORT" || {
        colorize red "Use at most 64 valid IPv4/IPv6 peer addresses (4096 bytes total)." bold
        press_key
        return 1
    }

    prompt_encryption_option || return 1
    prompt_multi_thread_option || return 1
    read -r -p "[-] Enable IPv6? (yes/no): " IPV6_CHOICE || return 1
    case "$IPV6_CHOICE" in
        [Nn]*) IPV6_OPTION="--disable-ipv6" ;;
        *) IPV6_OPTION="" ;;
    esac
    LISTENERS="--listeners ${DEFAULT_PROTOCOL}://[::]:${PORT} ${DEFAULT_PROTOCOL}://0.0.0.0:${PORT}"

    mesh_configuration_paths_are_safe || {
        colorize red "Refusing to use a symlinked configuration path or an unrecognized easymesh.service." bold
        press_key
        return 1
    }
    mkdir -p "$MESH_CONFIG_DIR" "$MESH_CONFIG_DIR/backups" || return 1
    chmod 0700 "$MESH_CONFIG_DIR" "$MESH_CONFIG_DIR/backups"
    staging_dir=$(mktemp -d "$MESH_CONFIG_DIR/.mesh-config.XXXXXX") || return 1
    if ! write_mesh_environment "$staging_dir/mesh.env" ||
       ! write_mesh_core_config "$staging_dir/easytier.toml" ||
       ! write_mesh_service "$staging_dir/easymesh.service" ||
       ! validate_staged_mesh_service "$staging_dir/easymesh.service" "$staging_dir/easytier.toml"; then
        rm -rf "$staging_dir"
        colorize red "Generated mesh configuration did not pass validation. Nothing was activated." bold
        press_key
        return 1
    fi

    activate_mesh_configuration "$staging_dir/mesh.env" "$staging_dir/easytier.toml" "$staging_dir/easymesh.service"
    local result=$?
    rm -rf "$staging_dir"
    press_key
    return "$result"
}


is_mesh_cli_ready() {
    if [[ ! -f $SERVICE_FILE ]] || ! systemctl is-active --quiet easymesh.service || [[ ! -x $EASY_CLIENT ]]; then
        colorize yellow "EasyMesh service is not running yet. Please connect to a mesh network first." bold
        press_key
        return 1
    fi
    return 0
}

get_watch_no_wrap_option() {
    local watch_help

    watch_help=$(watch --help 2>&1) || true
    if grep -Eq -- '(^|[[:space:]])-w([,[:space:]]|$)' <<< "$watch_help"; then
        printf '%s\n' '-w'
    elif grep -Fq -- '--no-wrap' <<< "$watch_help"; then
        printf '%s\n' '--no-wrap'
    else
        return 1
    fi
}

watch_mesh_view() {
    local view="$1"
    local client_command no_wrap_option quoted_client
    local -a watch_options=(-n1 -t)

    printf -v quoted_client '%q' "$EASY_CLIENT"
    client_command="$quoted_client $view"
    if [[ "$view" == "route" ]] && no_wrap_option=$(get_watch_no_wrap_option); then
