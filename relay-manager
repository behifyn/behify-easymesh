#!/usr/bin/env bash

set -o pipefail

RELAY_ROOT="/opt/behify-easymesh/relay"
RELAY_BIN_DIR="$RELAY_ROOT/bin"
RELAY_BINARY="$RELAY_BIN_DIR/behify-relayd"
RELAY_RELEASES_DIR="$RELAY_ROOT/releases"
RELAY_BACKUPS_DIR="$RELAY_ROOT/backups"
RELAY_LEGACY_XRAY_ROOT="$RELAY_ROOT/xray"
RELAY_LEGACY_XRAY_CURRENT="$RELAY_LEGACY_XRAY_ROOT/current"
RELAY_LEGACY_XRAY_BINARY="$RELAY_LEGACY_XRAY_CURRENT/xray"
RELAY_CONFIG_DIR="/etc/behify-easymesh/relay"
RELAY_DEFINITIONS="$RELAY_CONFIG_DIR/relays.json"
RELAY_CONFIG="$RELAY_CONFIG_DIR/config.json"
RELAY_SERVICE_FILE="/etc/systemd/system/behify-relay.service"
RELAY_SERVICE_NAME="behify-relay.service"
RELAY_SERVICE_DROPIN_DIR="/etc/systemd/system/behify-relay.service.d"
RELAY_KNOWN_NEUTRAL_DROPIN="$RELAY_SERVICE_DROPIN_DIR/10-neutral-binary.conf"
XRAY_RELEASE_API="https://api.github.com/repos/XTLS/Xray-core/releases/latest"
RELAY_TEMP_DIRS=()
RELAY_TEMP_FILES=()
RELAY_APPLY_FAILURE=""
RELAY_VALIDATED_VERSION=""
RELAY_SOURCE_ONLY=0

if [[ "${BEHIFY_RELAY_SOURCE_ONLY:-0}" == "1" && "${BASH_SOURCE[0]}" != "$0" ]]; then
    RELAY_SOURCE_ONLY=1
fi

relay_color() {
    local code="$1"
    shift
    if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
        printf '\033[%sm%s\033[0m\n' "$code" "$*"
    else
        printf '%s\n' "$*"
    fi
}

relay_box_line() {
    printf '| %-36s |\n' "$1"
}

if [[ "$RELAY_SOURCE_ONLY" != "1" && $EUID -ne 0 ]]; then
    printf 'Relay management must be run as root.\n' >&2
    exit 1
fi

relay_pause() {
    read -r -p "Press Enter to continue..." || true
}

relay_error() {
    printf 'Error: %s\n' "$1" >&2
}

relay_service_is_owned() {
    [[ -f "$RELAY_SERVICE_FILE" ]] && {
        grep -Fqx "ExecStart=$RELAY_BINARY run -config $RELAY_CONFIG" "$RELAY_SERVICE_FILE" ||
            grep -Fqx "ExecStart=$RELAY_LEGACY_XRAY_BINARY run -config $RELAY_CONFIG" "$RELAY_SERVICE_FILE"
    }
}

relay_service_uses_neutral_runtime() {
    [[ -f "$RELAY_SERVICE_FILE" ]] &&
        grep -Fqx "ExecStart=$RELAY_BINARY run -config $RELAY_CONFIG" "$RELAY_SERVICE_FILE"
}

safe_remove_temp_dir() {
    local temp_dir="$1"
    local temp_root resolved

    [[ -n "$temp_dir" && -d "$temp_dir" && "$temp_dir" != "/" ]] || return 0
    temp_root=$(readlink -f "${TMPDIR:-/tmp}") || return 1
    resolved=$(readlink -f "$temp_dir") || return 1
    [[ "$resolved" == "$temp_root"/* ]] || {
        relay_error "Refusing to remove unexpected temporary path: $resolved"
        return 1
    }
    rm -rf -- "$resolved"
}

assert_relay_temp_dir() {
    local candidate_dir="$1"
    local resolved_temp_root resolved_candidate

    [[ -n "$candidate_dir" && "$candidate_dir" != "/" && -d "$candidate_dir" ]] || {
        relay_error "Internal error: temporary directory output is empty or invalid."
        return 1
    }
    resolved_temp_root=$(readlink -f "${TMPDIR:-/tmp}") || {
        relay_error "Internal error: could not resolve the temporary root."
        return 1
    }
    resolved_candidate=$(readlink -f "$candidate_dir") || {
        relay_error "Internal error: could not resolve temporary directory $candidate_dir."
        return 1
    }
    [[ "$resolved_candidate" == "$resolved_temp_root"/* ]] || {
        relay_error "Internal error: temporary directory is outside $resolved_temp_root: $resolved_candidate"
        return 1
    }
}

assert_relay_temp_file() {
    local candidate_file="$1"

    [[ -n "$candidate_file" && "$candidate_file" != /*/../* && -f "$candidate_file" ]] || {
        relay_error "Internal error: temporary file output is empty or invalid."
        return 1
    }
    if [[ "$candidate_file" == /* && "${candidate_file#/}" != */* ]]; then
        relay_error "Internal error: refusing root-level temporary file: $candidate_file"
        return 1
    fi
}

safe_remove_managed_tree() {
    local managed_path="$1"

    case "$managed_path" in
        /opt/behify-easymesh/relay/bin|/opt/behify-easymesh/relay/releases|\
        /opt/behify-easymesh/relay/backups|/opt/behify-easymesh/relay/xray|\
        /etc/behify-easymesh/relay) ;;
        *)
            relay_error "Refusing to remove unexpected managed path: ${managed_path:-<empty>}"
            return 1
            ;;
    esac
    [[ -n "$managed_path" && "$managed_path" != "/" ]] || return 1
    rm -rf -- "$managed_path"
}

cleanup_relay_temp_dirs() {
    local temp_dir temp_file

    for temp_dir in "${RELAY_TEMP_DIRS[@]}"; do
        safe_remove_temp_dir "$temp_dir" || true
    done
    for temp_file in "${RELAY_TEMP_FILES[@]}"; do
        [[ -n "$temp_file" ]] && rm -f -- "$temp_file"
    done
}

make_relay_temp_dir() {
    local output_variable="$1"
    local created_dir

    [[ "$output_variable" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
        relay_error "Internal error: invalid temporary-directory output variable."
        return 1
    }
    case "$output_variable" in
        output_variable|created_dir)
            relay_error "Internal error: unsafe temporary-directory output variable: $output_variable"
            return 1
            ;;
    esac
    created_dir=$(mktemp -d) || return 1
    assert_relay_temp_dir "$created_dir" || return 1
    chmod 0700 "$created_dir" || {
        safe_remove_temp_dir "$created_dir"
        return 1
    }
    RELAY_TEMP_DIRS+=("$created_dir")
    printf -v "$output_variable" '%s' "$created_dir" || return 1
    [[ -n "${!output_variable:-}" ]] && assert_relay_temp_dir "${!output_variable}" || {
        relay_error "Internal error: temporary directory was not assigned to $output_variable."
        return 1
    }
}

make_relay_temp_file() {
    local output_variable="$1"
    local template="$2"
    local created_file

    [[ "$output_variable" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
        relay_error "Internal error: invalid temporary-file output variable."
        return 1
    }
    case "$output_variable" in
        output_variable|template|created_file)
            relay_error "Internal error: unsafe temporary-file output variable: $output_variable"
            return 1
            ;;
    esac
    created_file=$(mktemp "$template") || return 1
    assert_relay_temp_file "$created_file" || return 1
    RELAY_TEMP_FILES+=("$created_file")
    printf -v "$output_variable" '%s' "$created_file" || return 1
    [[ -n "${!output_variable:-}" ]] && assert_relay_temp_file "${!output_variable}" || {
        relay_error "Internal error: temporary file was not assigned to $output_variable."
        return 1
    }
}

trap cleanup_relay_temp_dirs EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

begin_relay_critical_section() {
    trap '' INT TERM HUP
}

end_relay_critical_section() {
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
}

ensure_relay_dependencies() {
    local command_name package
    local -a missing=()
    local -a packages=()

    if ! command -v systemctl >/dev/null 2>&1; then
        relay_error "This relay component requires a systemd-based server."
        return 1
    fi

    for command_name in curl jq unzip ss ip python3 sha256sum; do
        command -v "$command_name" >/dev/null 2>&1 && continue
        missing+=("$command_name")
        case "$command_name" in
            curl) package="curl" ;;
            jq) package="jq" ;;
            unzip) package="unzip" ;;
            ss|ip) package="iproute2" ;;
            python3) package="python3" ;;
            sha256sum) package="coreutils" ;;
        esac
        [[ " ${packages[*]} " == *" $package "* ]] || packages+=("$package")
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        return 0
    fi

    printf 'Installing required relay tools: %s\n' "${missing[*]}"
    if ! command -v apt-get >/dev/null 2>&1; then
        relay_error "Missing required tools and apt-get is unavailable: ${missing[*]}"
        return 1
    fi

    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates "${packages[@]}"
}

ensure_relay_storage() {
    local staged_definitions

    install -d -m 0755 "$RELAY_CONFIG_DIR" "$RELAY_BIN_DIR" "$RELAY_RELEASES_DIR" "$RELAY_BACKUPS_DIR" || {
        relay_error "Could not create the isolated relay storage directories."
        return 1
    }
    if [[ ! -f "$RELAY_DEFINITIONS" ]]; then
        make_relay_temp_file staged_definitions "$RELAY_CONFIG_DIR/.relays.json.XXXXXX" || return 1
        printf '[]\n' > "$staged_definitions" || return 1
        chmod 0600 "$staged_definitions" || return 1
        mv -f "$staged_definitions" "$RELAY_DEFINITIONS" || return 1
    fi
    jq empty "$RELAY_DEFINITIONS" >/dev/null 2>&1 || {
        relay_error "$RELAY_DEFINITIONS is not valid JSON."
        return 1
    }
}

resolve_xray_asset() {
    case "${1:-$(uname -m)}" in
        x86_64|amd64)
            printf 'Xray-linux-64.zip\n'
            ;;
        aarch64|arm64|armv8)
            printf 'Xray-linux-arm64-v8a.zip\n'
            ;;
        *)
            return 1
            ;;
    esac
}

fetch_latest_xray_release() {
    local asset asset_count metadata

    asset=$(resolve_xray_asset) || {
        relay_error "Unsupported Xray architecture: $(uname -m)"
        return 1
    }
    metadata=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
        --header 'Accept: application/vnd.github+json' \
        --header 'X-GitHub-Api-Version: 2022-11-28' \
        "$XRAY_RELEASE_API") || {
        relay_error "Could not query the official Xray release API."
        return 1
    }

    if ! printf '%s' "$metadata" | jq -e \
        '.draft == false and .prerelease == false and (.tag_name | type == "string")' \
        >/dev/null; then
        relay_error "The official release metadata is not a stable Xray release."
        return 1
    fi

    asset_count=$(printf '%s' "$metadata" | jq --arg asset "$asset" \
        '[.assets[] | select(.name == $asset)] | length')
    if [[ "$asset_count" != "1" ]]; then
        relay_error "The stable official release must contain exactly one $asset asset."
        return 1
    fi

    XRAY_LATEST_VERSION=$(printf '%s' "$metadata" | jq -r '.tag_name')
    XRAY_DOWNLOAD_URL=$(printf '%s' "$metadata" | jq -r --arg asset "$asset" \
        '.assets[] | select(.name == $asset) | .browser_download_url')
    XRAY_DOWNLOAD_DIGEST=$(printf '%s' "$metadata" | jq -r --arg asset "$asset" \
        '.assets[] | select(.name == $asset) | .digest // empty')

    if [[ ! "$XRAY_LATEST_VERSION" =~ ^v[0-9]+(\.[0-9]+)+$ ]] || \
       [[ "$XRAY_DOWNLOAD_URL" != "https://github.com/XTLS/Xray-core/releases/download/$XRAY_LATEST_VERSION/$asset" ]] || \
       [[ ! "$XRAY_DOWNLOAD_DIGEST" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
        relay_error "Official release URL or SHA-256 digest is missing or invalid."
        return 1
    fi
}

switch_relay_runtime() {
    local target_binary="$1"
    local new_link

    install -d -m 0755 "$RELAY_BIN_DIR" || return 1
    make_relay_temp_file new_link "$RELAY_BIN_DIR/.behify-relayd.XXXXXX" || return 1
    rm -f "$new_link" || return 1
    ln -s "$target_binary" "$new_link" || return 1
    if ! mv -Tf "$new_link" "$RELAY_BINARY"; then
        rm -f "$new_link"
        return 1
    fi
}

archive_entries_are_safe() {
    local archive="$1"
    local archive_entries entry xray_count=0

    archive_entries=$(unzip -Z1 "$archive") || {
        relay_error "Could not inspect Xray archive entries."
        return 1
    }

    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        if [[ "$entry" == /* || "$entry" == *\\* || "$entry" =~ ^[A-Za-z]: || \
              "$entry" == ".." || "$entry" == ../* || "$entry" == */../* || "$entry" == */.. ]]; then
            relay_error "Unsafe path in Xray archive: $entry"
            return 1
        fi
        [[ "$entry" == "xray" ]] && ((xray_count += 1))
    done <<< "$archive_entries"

    [[ "$xray_count" == "1" ]] || {
        relay_error "Xray archive must contain exactly one root-level xray executable."
        return 1
    }
}

download_verified_xray_candidate() {
    local temp_dir="$1"
    local archive="$temp_dir/xray.zip"
    local effective_url expected_hash

    printf 'Downloading isolated Xray %s...\n' "$XRAY_LATEST_VERSION"
    effective_url=$(curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
        --location --max-redirs 5 --output "$archive" --write-out '%{url_effective}' \
        "$XRAY_DOWNLOAD_URL") || {
        relay_error "Xray archive download failed."
        return 1
    }
    case "$effective_url" in
        https://github.com/XTLS/Xray-core/releases/download/*|\
        https://release-assets.githubusercontent.com/*|\
        https://objects.githubusercontent.com/*) ;;
        *)
            relay_error "Xray download redirected to an unexpected host: $effective_url"
            return 1
            ;;
    esac

    expected_hash=${XRAY_DOWNLOAD_DIGEST#sha256:}
    if ! printf '%s  %s\n' "$expected_hash" "$archive" | sha256sum -c - >/dev/null; then
        relay_error "Xray SHA-256 verification failed."
        return 1
    fi
    archive_entries_are_safe "$archive" || return 1

    install -d -m 0700 "$temp_dir/unpacked" || {
        relay_error "Could not create the private Xray extraction directory."
        return 1
    }
    if ! unzip -q "$archive" xray -d "$temp_dir/unpacked" || \
       [[ ! -f "$temp_dir/unpacked/xray" || -L "$temp_dir/unpacked/xray" ]]; then
        relay_error "Could not extract the expected Xray executable."
        return 1
    fi
    if ! mv "$temp_dir/unpacked/xray" "$temp_dir/unpacked/behify-relayd" ||
       ! chmod 0700 "$temp_dir/unpacked/behify-relayd"; then
        relay_error "Could not stage the verified Xray asset under the neutral runtime name."
        return 1
    fi
    if ! validate_relay_runtime_candidate "$temp_dir/unpacked/behify-relayd" temporary ""; then
        relay_error "Verified Xray binary validation failed on $(uname -m)."
        return 1
    fi

    XRAY_CANDIDATE_BINARY="$temp_dir/unpacked/behify-relayd"
}

activate_xray_candidate() {
    local version="$1"
    local candidate_binary="$2"
    local release_dir staged_binary

    [[ "$(basename "$candidate_binary")" == "behify-relayd" ]] || {
        relay_error "Refusing to activate a relay candidate without the neutral runtime name."
        return 1
    }
    release_dir="$RELAY_RELEASES_DIR/${version#v}-$(date +%Y%m%d-%H%M%S)-$$"
    install -d -m 0755 "$release_dir" || return 1
    make_relay_temp_file staged_binary "$release_dir/.behify-relayd.XXXXXX" || return 1
    if ! install -m 0755 "$candidate_binary" "$staged_binary"; then
        relay_error "Could not stage the isolated relay runtime for activation."
        rm -f "$staged_binary"
        return 1
    fi
    if ! verify_relay_copy_digest "$candidate_binary" "$staged_binary"; then
        rm -f "$staged_binary"
        return 1
    fi
    if ! mv -f "$staged_binary" "$release_dir/behify-relayd" || \
       ! validate_relay_runtime_candidate "$release_dir/behify-relayd" release "" || \
       ! switch_relay_runtime "$release_dir/behify-relayd"; then
        rm -f "$staged_binary"
        relay_error "Could not atomically activate the isolated Xray release."
        return 1
    fi
}

ensure_relay_service() {
    local temp_dir temp_service

    make_relay_temp_dir temp_dir || return 1
    temp_service="$temp_dir/behify-relay.service"
    if ! printf '%s\n' \
        '[Unit]' \
        'Description=Behify EasyMesh Dokodemo-Door Relay' \
        'After=network-online.target easymesh.service' \
        'Wants=network-online.target easymesh.service' \
        '' \
        '[Service]' \
        'Type=simple' \
        "ExecStart=$RELAY_BINARY run -config $RELAY_CONFIG" \
        'Restart=on-failure' \
        'RestartSec=3' \
        'NoNewPrivileges=true' \
        '' \
        '[Install]' \
        'WantedBy=multi-user.target' > "$temp_service"; then
        safe_remove_temp_dir "$temp_dir"
        relay_error "Could not stage $RELAY_SERVICE_FILE."
        return 1
    fi

    if [[ -f "$RELAY_SERVICE_FILE" ]] && cmp -s "$temp_service" "$RELAY_SERVICE_FILE"; then
        safe_remove_temp_dir "$temp_dir"
        return 0
    fi
    if [[ -f "$RELAY_SERVICE_FILE" ]] && ! relay_service_is_owned; then
        safe_remove_temp_dir "$temp_dir"
        relay_error "Refusing to overwrite an unrecognized service file at $RELAY_SERVICE_FILE."
        return 1
    fi

    if ! install -m 0644 "$temp_service" "$RELAY_SERVICE_FILE"; then
        safe_remove_temp_dir "$temp_dir"
        relay_error "Could not install $RELAY_SERVICE_FILE."
        return 1
    fi
    safe_remove_temp_dir "$temp_dir"
    systemctl daemon-reload || {
        relay_error "systemctl daemon-reload failed after relay unit update."
        return 1
    }
}

parse_relay_runtime_version_output() {
    local version_output="$1"
    local first_line

    first_line=${version_output%%$'\n'*}
    if [[ "$first_line" =~ ^Xray[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+)([[:space:]]|$) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

get_relay_runtime_version() {
    local runtime_binary="$1"
    local version_output

    [[ -x "$runtime_binary" ]] || return 1
    version_output=$("$runtime_binary" version 2>&1) || return 1
    parse_relay_runtime_version_output "$version_output"
}

relay_runtime_is_executable() {
    [[ -x "$1" ]]
}

relay_runtime_is_symlink() {
    [[ -L "$1" ]]
}

relay_runtime_path_is_safe() {
    local runtime_binary="$1"
    local path_scope="$2"
    local resolved_binary resolved_root resolved_tracked runtime_owner link_owner
    local tracked_temp tracked_match=0

    if [[ "$(basename "$runtime_binary")" != "behify-relayd" ]]; then
        relay_error "Invalid runtime basename; the executed candidate must be named behify-relayd."
        return 1
    fi
    if [[ ! -f "$runtime_binary" ]]; then
        relay_error "Neutral relay candidate is not a regular file: $runtime_binary"
        return 1
    fi
    if ! relay_runtime_is_executable "$runtime_binary"; then
        relay_error "Executable permission validation failed for the neutral relay candidate."
        return 1
    fi
    resolved_binary=$(readlink -f "$runtime_binary") || {
        relay_error "Unsafe staging path; the neutral relay candidate could not be resolved."
        return 1
    }
    if [[ "$(basename "$resolved_binary")" != "behify-relayd" ]]; then
        relay_error "Invalid runtime basename after canonical-path resolution."
        return 1
    fi

    case "$path_scope" in
        temporary)
            if relay_runtime_is_symlink "$runtime_binary"; then
                relay_error "Unsafe staging path; temporary relay candidates must not be symlinks."
                return 1
            fi
            resolved_root=$(readlink -f "${TMPDIR:-/tmp}") || {
                relay_error "Unsafe staging path; the temporary root could not be resolved."
                return 1
            }
            [[ "$resolved_binary" == "$resolved_root"/* ]] || {
                relay_error "Unsafe staging path; the relay candidate is outside the temporary root."
                return 1
            }
            for tracked_temp in "${RELAY_TEMP_DIRS[@]}"; do
                resolved_tracked=$(readlink -f "$tracked_temp" 2>/dev/null) || continue
                if [[ "$resolved_binary" == "$resolved_tracked"/* ]]; then
                    tracked_match=1
                    break
                fi
            done
            [[ "$tracked_match" == "1" ]] || {
                relay_error "Unsafe staging path; the relay candidate is outside manager-created temporary directories."
                return 1
            }
            ;;
        release)
            if relay_runtime_is_symlink "$runtime_binary"; then
                relay_error "Unsafe release path; an activated relay release must not be a symlink."
                return 1
            fi
            resolved_root=$(readlink -f "$RELAY_RELEASES_DIR") || {
                relay_error "Unsafe release path; the managed releases directory could not be resolved."
                return 1
            }
            [[ "$resolved_binary" == "$resolved_root"/* ]] || {
                relay_error "Unsafe release path; the relay candidate is outside the managed releases directory."
                return 1
            }
            ;;
        managed)
            [[ "$runtime_binary" == "$RELAY_BINARY" ]] || {
                relay_error "Unsafe managed path; only the configured neutral relay runtime may be reused."
                return 1
            }
            if relay_runtime_is_symlink "$runtime_binary"; then
                resolved_root=$(readlink -f "$RELAY_RELEASES_DIR") || {
                    relay_error "Unsafe managed path; the managed releases directory could not be resolved."
                    return 1
                }
                [[ "$resolved_binary" == "$resolved_root"/* ]] || {
                    relay_error "Unsafe managed path; the neutral runtime symlink points outside managed releases."
                    return 1
                }
            fi
            ;;
        *)
            relay_error "Internal error: unknown relay runtime path scope."
            return 1
            ;;
    esac

    runtime_owner=$(stat -Lc '%u' "$runtime_binary" 2>/dev/null) || {
        relay_error "Runtime ownership validation failed for the neutral relay candidate."
        return 1
    }
    [[ "$runtime_owner" == "$EUID" ]] || {
        relay_error "Runtime ownership validation failed for the neutral relay candidate."
        return 1
    }
    if relay_runtime_is_symlink "$runtime_binary"; then
        link_owner=$(stat -c '%u' "$runtime_binary" 2>/dev/null) || {
            relay_error "Runtime symlink ownership validation failed for the neutral relay candidate."
            return 1
        }
        [[ "$link_owner" == "$EUID" ]] || {
            relay_error "Runtime symlink ownership validation failed for the neutral relay candidate."
            return 1
        }
    fi
}

validate_relay_runtime_candidate() {
    local runtime_binary="$1"
    local path_scope="$2"
    local config_path="${3:-}"
    local version_output version

    RELAY_VALIDATED_VERSION=""
    relay_runtime_path_is_safe "$runtime_binary" "$path_scope" || return 1
    if ! version_output=$("$runtime_binary" version 2>&1); then
        relay_error "Version execution failed for the neutral relay candidate."
        return 1
    fi
    version=$(parse_relay_runtime_version_output "$version_output") || {
        relay_error "Version parsing failed; the candidate did not return recognized Xray version output."
        return 1
    }
    if [[ -n "$config_path" ]] && \
       ! "$runtime_binary" run -test -config "$config_path" >/dev/null 2>&1; then
        relay_error "Configuration validation failed for the neutral relay candidate."
        return 1
    fi
    RELAY_VALIDATED_VERSION="$version"
}

verify_relay_copy_digest() {
    local source_file="$1"
    local staged_file="$2"
    local source_digest staged_digest

    source_digest=$(sha256sum "$source_file" 2>/dev/null) || {
        relay_error "Source and staged digest comparison failed."
        return 1
    }
    staged_digest=$(sha256sum "$staged_file" 2>/dev/null) || {
        relay_error "Source and staged digest comparison failed."
        return 1
    }
    source_digest=${source_digest%% *}
    staged_digest=${staged_digest%% *}
    [[ "$source_digest" == "$staged_digest" ]] || {
        relay_error "Source and staged digest mismatch."
        return 1
    }
}

legacy_relay_source_is_safe() {
    local resolved_source resolved_legacy_root source_owner

    [[ -f "$RELAY_LEGACY_XRAY_BINARY" ]] || {
        relay_error "Unsafe legacy source path; the isolated Xray source is not a regular file."
        return 1
    }
    relay_runtime_is_executable "$RELAY_LEGACY_XRAY_BINARY" || {
        relay_error "Executable permission validation failed for the legacy isolated Xray source."
        return 1
    }
    resolved_source=$(readlink -f "$RELAY_LEGACY_XRAY_BINARY") || {
        relay_error "Unsafe legacy source path; the isolated Xray source could not be resolved."
        return 1
    }
    resolved_legacy_root=$(readlink -f "$RELAY_LEGACY_XRAY_ROOT") || {
        relay_error "Unsafe legacy source path; the isolated Xray root could not be resolved."
        return 1
    }
    [[ "$resolved_source" == "$resolved_legacy_root"/* ]] || {
        relay_error "Unsafe legacy source path; the isolated Xray source resolves outside Behify relay storage."
        return 1
    }
    [[ "$(basename "$resolved_source")" == "xray" ]] || {
        relay_error "Invalid legacy source basename; expected the isolated xray release file."
        return 1
    }
    source_owner=$(stat -Lc '%u' "$RELAY_LEGACY_XRAY_BINARY" 2>/dev/null) || {
        relay_error "Legacy source ownership validation failed."
        return 1
    }
    [[ "$source_owner" == "$EUID" ]] || {
        relay_error "Legacy source ownership validation failed."
        return 1
    }
}

known_neutral_dropin_matches() {
    [[ -f "$RELAY_KNOWN_NEUTRAL_DROPIN" ]] || return 1
    cmp -s "$RELAY_KNOWN_NEUTRAL_DROPIN" <(printf '%s\n' \
        '[Service]' \
        'ExecStart=' \
        "ExecStart=$RELAY_BINARY run -config $RELAY_CONFIG")
}

backup_relay_runtime_state() {
    local backup_dir="$1"

    mkdir -p "$backup_dir" && chmod 0700 "$backup_dir" || return 1
    if [[ -L "$RELAY_BINARY" ]]; then
        readlink "$RELAY_BINARY" > "$backup_dir/runtime-link" || return 1
    elif [[ -f "$RELAY_BINARY" ]]; then
        install -m 0755 "$RELAY_BINARY" "$backup_dir/behify-relayd" || return 1
    else
        : > "$backup_dir/runtime-missing" || return 1
    fi
}

restore_relay_runtime_state() {
    local backup_dir="$1"

    rm -f "$RELAY_BINARY" || return 1
    install -d -m 0755 "$RELAY_BIN_DIR" || return 1
    if [[ -f "$backup_dir/runtime-link" ]]; then
        ln -s "$(cat "$backup_dir/runtime-link")" "$RELAY_BINARY" || return 1
    elif [[ -f "$backup_dir/behify-relayd" ]]; then
        install -m 0755 "$backup_dir/behify-relayd" "$RELAY_BINARY" || return 1
    elif [[ ! -f "$backup_dir/runtime-missing" ]]; then
        return 1
    fi
}

verify_relay_process_name() {
    local pid executable

    pid=$(systemctl show -p MainPID --value "$RELAY_SERVICE_NAME" 2>/dev/null) || return 1
    [[ "$pid" =~ ^[0-9]+$ && "$pid" != "0" ]] || return 1
    executable=$(readlink -f "/proc/$pid/exe" 2>/dev/null) || return 1
    [[ "$(basename "$executable")" == "behify-relayd" ]]
}

rollback_neutral_runtime_migration() {
    local backup_dir="$1"
    local service_was_active="$2"
    local unit_existed="$3"
    local dropin_was_removed="$4"
    local rollback_failed=0

    restore_relay_runtime_state "$backup_dir/runtime" || rollback_failed=1
    if [[ "$unit_existed" == "1" ]]; then
        install -m 0644 "$backup_dir/behify-relay.service" "$RELAY_SERVICE_FILE" || rollback_failed=1
    else
        rm -f "$RELAY_SERVICE_FILE" || rollback_failed=1
    fi
    if [[ "$dropin_was_removed" == "1" ]]; then
        install -d -m 0755 "$RELAY_SERVICE_DROPIN_DIR" || rollback_failed=1
        install -m 0644 "$backup_dir/10-neutral-binary.conf" "$RELAY_KNOWN_NEUTRAL_DROPIN" || rollback_failed=1
    fi
    systemctl daemon-reload >/dev/null 2>&1 || rollback_failed=1
    if [[ "$service_was_active" == "1" ]]; then
        systemctl restart "$RELAY_SERVICE_NAME" >/dev/null 2>&1 || rollback_failed=1
    else
        systemctl stop "$RELAY_SERVICE_NAME" >/dev/null 2>&1 || true
    fi
    [[ "$rollback_failed" == "0" ]]
}

migrate_legacy_relay_runtime() {
    local temp_dir backup_dir candidate_binary version timestamp
    local service_was_active=0 service_was_enabled=0 unit_existed=0
    local runtime_needs_activation=0 dropin_was_removed=0 migration_failed=0
    local neutral_runtime_present=0

    [[ -e "$RELAY_BINARY" || -L "$RELAY_BINARY" ]] && neutral_runtime_present=1
    if [[ "$neutral_runtime_present" == "1" ]] && \
       validate_relay_runtime_candidate "$RELAY_BINARY" managed ""; then
        candidate_binary="$RELAY_BINARY"
        version="$RELAY_VALIDATED_VERSION"
    elif [[ -x "$RELAY_LEGACY_XRAY_BINARY" ]]; then
        legacy_relay_source_is_safe || return 1
        make_relay_temp_dir temp_dir || return 1
        candidate_binary="$temp_dir/behify-relayd"
        install -m 0755 "$RELAY_LEGACY_XRAY_BINARY" "$candidate_binary" || {
            relay_error "Staged copy failed for the existing isolated Xray."
            return 1
        }
        verify_relay_copy_digest "$RELAY_LEGACY_XRAY_BINARY" "$candidate_binary" || return 1
        validate_relay_runtime_candidate "$candidate_binary" temporary "" || {
            relay_error "Existing isolated Xray validation failed after neutral-name staging."
            return 1
        }
        version="$RELAY_VALIDATED_VERSION"
        runtime_needs_activation=1
    elif [[ "$neutral_runtime_present" == "1" ]]; then
        relay_error "No valid neutral relay runtime or migratable isolated Xray is available."
        return 1
    else
        return 0
    fi

    if [[ -f "$RELAY_CONFIG" ]]; then
        if [[ "$candidate_binary" == "$RELAY_BINARY" ]]; then
            validate_relay_runtime_candidate "$candidate_binary" managed "$RELAY_CONFIG" || return 1
        else
            validate_relay_runtime_candidate "$candidate_binary" temporary "$RELAY_CONFIG" || return 1
        fi
        version="$RELAY_VALIDATED_VERSION"
    fi

    if [[ "$runtime_needs_activation" == "0" ]] && relay_service_uses_neutral_runtime && \
       ! known_neutral_dropin_matches; then
        if systemctl is-active --quiet "$RELAY_SERVICE_NAME" && ! verify_relay_process_name; then
            relay_error "The active relay service is not running with the neutral behify-relayd process name."
            return 1
        fi
        return 0
    fi

    systemctl is-active --quiet "$RELAY_SERVICE_NAME" && service_was_active=1
    systemctl is-enabled --quiet "$RELAY_SERVICE_NAME" && service_was_enabled=1
    [[ -f "$RELAY_SERVICE_FILE" ]] && unit_existed=1
    timestamp=$(date +%Y%m%d-%H%M%S)
    backup_dir="$RELAY_BACKUPS_DIR/migration-$timestamp-$$"
    mkdir -p "$backup_dir" && chmod 0700 "$backup_dir" || return 1
    backup_relay_runtime_state "$backup_dir/runtime" || return 1
    [[ "$unit_existed" == "0" ]] || cp "$RELAY_SERVICE_FILE" "$backup_dir/behify-relay.service" || return 1
    if known_neutral_dropin_matches; then
        cp "$RELAY_KNOWN_NEUTRAL_DROPIN" "$backup_dir/10-neutral-binary.conf" || return 1
    fi

    begin_relay_critical_section
    if [[ "$runtime_needs_activation" == "1" ]] && \
       ! activate_xray_candidate "v$version" "$candidate_binary"; then
        migration_failed=1
    fi
    if [[ "$migration_failed" == "0" && "$unit_existed" == "1" ]] && ! ensure_relay_service; then
        migration_failed=1
    fi
    if [[ "$migration_failed" == "0" ]] && relay_service_uses_neutral_runtime && \
       known_neutral_dropin_matches; then
        rm -f "$RELAY_KNOWN_NEUTRAL_DROPIN" || migration_failed=1
        [[ "$migration_failed" != "0" ]] || dropin_was_removed=1
        [[ "$migration_failed" != "0" ]] || systemctl daemon-reload >/dev/null 2>&1 || migration_failed=1
    fi
    if [[ "$migration_failed" == "0" && "$service_was_active" == "1" ]]; then
        if ! systemctl restart "$RELAY_SERVICE_NAME" || \
           ! systemctl is-active --quiet "$RELAY_SERVICE_NAME" || \
           ! verify_relay_process_name; then
            migration_failed=1
        elif [[ -f "$RELAY_DEFINITIONS" ]] && \
             { ! validate_relay_definitions_file "$RELAY_DEFINITIONS" || \
               ! verify_relay_sockets "$RELAY_DEFINITIONS"; }; then
            migration_failed=1
        fi
    fi

    if [[ "$migration_failed" != "0" ]]; then
        relay_error "Neutral relay runtime migration failed. Restoring the previous state."
        rollback_neutral_runtime_migration "$backup_dir" "$service_was_active" \
            "$unit_existed" "$dropin_was_removed" || \
            relay_error "Neutral runtime rollback was incomplete. Backup: $backup_dir"
        end_relay_critical_section
        return 1
    fi
    end_relay_critical_section

    # Neither migration nor rollback changes enablement; assert it remained stable.
    if [[ "$service_was_enabled" == "1" ]] && ! systemctl is-enabled --quiet "$RELAY_SERVICE_NAME"; then
        relay_error "Relay service enablement changed unexpectedly during migration."
        return 1
    fi
    printf 'Isolated Xray runtime is ready as %s (v%s).\n' "$RELAY_BINARY" "$version"
}

validate_relay_definitions_file() {
    local definitions="$1"
    local listen_address destination_ip

    jq -e '
        def protocol_overlap($a; $b):
            $a == "both" or $b == "both" or $a == $b;
        def address_overlap($a; $b):
            $a == $b or
            $a == "::" or $b == "::" or
            ($a == "0.0.0.0" and ($b | contains(":") | not)) or
            ($b == "0.0.0.0" and ($a | contains(":") | not));
        type == "array" and
        all(.[];
            (.name | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
            (.protocol == "tcp" or .protocol == "udp" or .protocol == "both") and
            (.listen_address | type == "string") and
            (.destination_ip | type == "string") and
            (.listen_port | type == "number" and floor == . and . >= 1 and . <= 65535) and
            (.destination_port | type == "number" and floor == . and . >= 1 and . <= 65535) and
            (.enabled | type == "boolean")
        ) and
        (([.[].name] | length) == ([.[].name] | unique | length)) and
        ([range(0; length) as $left |
          range($left + 1; length) as $right |
          select(
              .[$left].enabled == true and .[$right].enabled == true and
              .[$left].listen_port == .[$right].listen_port and
              protocol_overlap(.[$left].protocol; .[$right].protocol) and
              address_overlap(.[$left].listen_address; .[$right].listen_address)
          )] | length == 0)
    ' "$definitions" >/dev/null || {
        relay_error "Relay definitions contain invalid, duplicate, or overlapping records."
        return 1
    }

    while IFS=$'\t' read -r listen_address destination_ip; do
        is_valid_listen_address "$listen_address" && is_valid_ip "$destination_ip" || {
            relay_error "Relay definitions contain an invalid listen or destination IP."
            return 1
        }
    done < <(jq -r '.[] | [.listen_address, .destination_ip] | @tsv' "$definitions")
}

generate_xray_config() {
    local definitions="$1"
    local output="$2"

    jq '
        def networks($protocol):
            if $protocol == "both" then ["tcp", "udp"] else [$protocol] end;
        [
            .[] | select(.enabled == true) | . as $relay |
            networks($relay.protocol)[] as $network |
            {
                tag: ("behify-relay-" + $relay.name + "-" + $network + "-" + ($relay.listen_port | tostring)),
                listen: $relay.listen_address,
                port: $relay.listen_port,
                protocol: "dokodemo-door",
                settings: {
                    address: $relay.destination_ip,
                    port: $relay.destination_port,
                    network: $network,
                    followRedirect: false
                }
            }
        ] as $inbounds |
        {
            inbounds: $inbounds,
            outbounds: [
                {
                    tag: "direct",
                    protocol: "freedom",
                    settings: {}
                }
            ],
            routing: {
                rules: [
                    $inbounds[] |
                    {
                        type: "field",
                        inboundTag: [.tag],
                        outboundTag: "direct"
                    }
                ]
            }
        }
    ' "$definitions" > "$output"
}

restore_relay_config_backup() {
    local backup_dir="$1"
    local restore_failed=0

    if [[ -f "$backup_dir/relays.json" ]]; then
        install -m 0600 "$backup_dir/relays.json" "$RELAY_DEFINITIONS" || restore_failed=1
    else
        rm -f "$RELAY_DEFINITIONS" || restore_failed=1
    fi
    if [[ -f "$backup_dir/config.json" ]]; then
        install -m 0600 "$backup_dir/config.json" "$RELAY_CONFIG" || restore_failed=1
    else
        rm -f "$RELAY_CONFIG" || restore_failed=1
    fi

    [[ "$restore_failed" == "0" ]]
}

apply_relay_definitions() {
    local candidate_definitions="$1"
    local temp_dir xray_temp_dir backup_dir timestamp staged_relays staged_config
    local confirm validation_binary relay_count
    local resolved_candidate resolved_destination resolved_temp_root
    local service_was_active=0 service_was_enabled=0 service_file_existed=0 runtime_activated=0

    RELAY_APPLY_FAILURE="transaction_failed"
    resolved_temp_root=$(readlink -f "${TMPDIR:-/tmp}") || return 1
    resolved_candidate=$(readlink -f "$candidate_definitions") || {
        relay_error "Internal error: candidate relay definitions could not be resolved."
        return 1
    }
    if [[ "$resolved_candidate" == "/relays.json" || "$resolved_candidate" == "/config.json" || \
          "$resolved_candidate" != "$resolved_temp_root"/* ]]; then
        relay_error "Internal error: candidate relay definitions are outside the temporary root: $resolved_candidate"
        return 1
    fi
    if [[ ! -x "$RELAY_BINARY" ]] && ! resolve_xray_asset >/dev/null; then
        relay_error "Unsupported Xray architecture: $(uname -m)"
        return 1
    fi
    systemctl is-active --quiet "$RELAY_SERVICE_NAME" && service_was_active=1
    systemctl is-enabled --quiet "$RELAY_SERVICE_NAME" && service_was_enabled=1
    [[ -f "$RELAY_SERVICE_FILE" ]] && service_file_existed=1
    timestamp=$(date +%Y%m%d-%H%M%S)
    backup_dir="$RELAY_CONFIG_DIR/backups/$timestamp"
    while [[ -e "$backup_dir" ]]; do
        sleep 1
        timestamp=$(date +%Y%m%d-%H%M%S)
        backup_dir="$RELAY_CONFIG_DIR/backups/$timestamp"
    done
    install -d -m 0700 "$backup_dir" || return 1
    if [[ -f "$RELAY_DEFINITIONS" ]] && ! cp "$RELAY_DEFINITIONS" "$backup_dir/relays.json"; then
        relay_error "Could not back up relays.json."
        return 1
    fi
    if [[ -f "$RELAY_CONFIG" ]] && ! cp "$RELAY_CONFIG" "$backup_dir/config.json"; then
        relay_error "Could not back up config.json."
        return 1
    fi
    backup_relay_runtime_state "$backup_dir/runtime" || return 1

    make_relay_temp_dir temp_dir || return 1
    resolved_destination="$(readlink -f "$temp_dir")/relays.json"
    if [[ "$resolved_candidate" == "$resolved_destination" ]]; then
        relay_error "Internal error: candidate relay definitions source and destination are the same file."
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi
    cp -- "$resolved_candidate" "$resolved_destination" || {
        safe_remove_temp_dir "$temp_dir"
        return 1
    }
    if ! validate_relay_definitions_file "$temp_dir/relays.json" || \
       ! generate_xray_config "$temp_dir/relays.json" "$temp_dir/config.json" || \
       ! jq empty "$temp_dir/relays.json" || \
       ! jq -e '([.inbounds[].tag] | length) == ([.inbounds[].tag] | unique | length)' \
           "$temp_dir/config.json" >/dev/null; then
        relay_error "Generated relay configuration failed validation. Production files were not changed."
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi

    relay_count=$(jq '[.[] | select(.enabled == true)] | length' "$temp_dir/relays.json")
    if [[ -x "$RELAY_BINARY" ]]; then
        validation_binary="$RELAY_BINARY"
    else
        printf 'The isolated Behify relay Xray is not installed.\n'
        printf 'The relay component requires its own isolated Xray installation.\n'
        printf 'Existing panel and system Xray installations will not be touched.\n'
        read -r -p "Download and install the stable official Xray release? [y/N] " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || {
            RELAY_APPLY_FAILURE="xray_cancelled"
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
        fetch_latest_xray_release || {
            RELAY_APPLY_FAILURE="xray_install_failed"
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
        make_relay_temp_dir xray_temp_dir || {
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
        download_verified_xray_candidate "$xray_temp_dir" || {
            RELAY_APPLY_FAILURE="xray_install_failed"
            safe_remove_temp_dir "$xray_temp_dir"
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
        validation_binary="$XRAY_CANDIDATE_BINARY"
    fi

    if ! "$validation_binary" run -test -config "$temp_dir/config.json" >/dev/null 2>&1; then
        RELAY_APPLY_FAILURE="config_rejected"
        relay_error "Candidate Xray configuration test failed. Production files were not changed."
        [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi

    begin_relay_critical_section
    if [[ "$validation_binary" != "$RELAY_BINARY" ]]; then
        if ! activate_xray_candidate "$XRAY_LATEST_VERSION" "$validation_binary"; then
            RELAY_APPLY_FAILURE="xray_install_failed"
            safe_remove_temp_dir "$xray_temp_dir"
            safe_remove_temp_dir "$temp_dir"
            end_relay_critical_section
            return 1
        fi
        runtime_activated=1
    fi

    if [[ "$relay_count" -gt 0 ]] && ! ensure_relay_service; then
        [[ "$runtime_activated" == "0" ]] || restore_relay_runtime_state "$backup_dir/runtime"
        [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        return 1
    fi

    make_relay_temp_file staged_relays "$RELAY_CONFIG_DIR/.relays.json.XXXXXX" || {
        [[ "$runtime_activated" == "0" ]] || restore_relay_runtime_state "$backup_dir/runtime"
        [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        return 1
    }
    make_relay_temp_file staged_config "$RELAY_CONFIG_DIR/.config.json.XXXXXX" || {
        rm -f "$staged_relays"
        [[ "$runtime_activated" == "0" ]] || restore_relay_runtime_state "$backup_dir/runtime"
        [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        return 1
    }
    if ! install -m 0600 "$temp_dir/relays.json" "$staged_relays" || \
       ! install -m 0600 "$temp_dir/config.json" "$staged_config" || \
       ! mv -f "$staged_relays" "$RELAY_DEFINITIONS" || \
       ! mv -f "$staged_config" "$RELAY_CONFIG"; then
        relay_error "Could not atomically install the relay configuration. Rolling back."
        rm -f "$staged_relays" "$staged_config"
        if restore_relay_config_backup "$backup_dir"; then
            printf 'Rollback completed. Previous relay files were restored.\n'
        else
            relay_error "Automatic rollback failed. Backup retained at $backup_dir."
        fi
        [[ "$runtime_activated" == "0" ]] || \
            restore_relay_runtime_state "$backup_dir/runtime" || relay_error "Could not restore previous relay runtime."
        [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        return 1
    fi

    if [[ "$relay_count" == "0" ]]; then
        if [[ -f "$RELAY_SERVICE_FILE" ]] && \
           ! systemctl disable --now "$RELAY_SERVICE_NAME"; then
            relay_error "Could not stop the empty relay service. Rolling back."
            restore_relay_config_backup "$backup_dir" || relay_error "Config rollback failed: $backup_dir"
            [[ "$runtime_activated" == "0" ]] || \
                restore_relay_runtime_state "$backup_dir/runtime" || relay_error "Could not restore previous relay runtime."
            [[ "$service_was_active" == "1" ]] && systemctl restart "$RELAY_SERVICE_NAME" >/dev/null 2>&1
            [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
            safe_remove_temp_dir "$temp_dir"
            end_relay_critical_section
            return 1
        fi
        [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        printf 'No enabled relays remain. %s is stopped and disabled.\n' "$RELAY_SERVICE_NAME"
        return 0
    fi

    if ! systemctl enable "$RELAY_SERVICE_NAME" >/dev/null 2>&1 || \
       ! systemctl restart "$RELAY_SERVICE_NAME" || \
       ! systemctl is-active --quiet "$RELAY_SERVICE_NAME" || \
       ! verify_relay_process_name || \
       ! verify_relay_sockets "$temp_dir/relays.json"; then
        RELAY_APPLY_FAILURE="service_rollback"
        relay_error "Relay service failed after configuration change. Rolling back."
        if restore_relay_config_backup "$backup_dir"; then
            printf 'Rollback completed. Previous relay files were restored.\n'
        else
            relay_error "Automatic rollback failed. Backup retained at $backup_dir."
        fi
        [[ "$runtime_activated" == "0" ]] || \
            restore_relay_runtime_state "$backup_dir/runtime" || relay_error "Could not restore previous relay runtime."
        if [[ "$service_was_active" == "1" && -f "$backup_dir/config.json" ]]; then
            if systemctl restart "$RELAY_SERVICE_NAME" >/dev/null 2>&1; then
                printf 'Previous relay service restarted successfully.\n'
            else
                relay_error "Previous configuration was restored, but the relay service did not restart."
            fi
        else
            systemctl stop "$RELAY_SERVICE_NAME" >/dev/null 2>&1 || true
        fi
        [[ "$service_was_enabled" == "1" ]] || systemctl disable "$RELAY_SERVICE_NAME" >/dev/null 2>&1 || true
        if [[ "$service_file_existed" == "0" && -f "$RELAY_SERVICE_FILE" ]] && relay_service_is_owned; then
            rm -f "$RELAY_SERVICE_FILE"
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        return 1
    fi

    [[ -n "$xray_temp_dir" ]] && safe_remove_temp_dir "$xray_temp_dir"
    safe_remove_temp_dir "$temp_dir"
    end_relay_critical_section
    RELAY_APPLY_FAILURE=""
    printf 'Relay configuration applied successfully. Backup: %s\n' "$backup_dir"
}

is_valid_ip() {
    python3 -c 'import ipaddress, sys; ipaddress.ip_address(sys.argv[1])' "$1" >/dev/null 2>&1
}

is_valid_listen_address() {
    local address="$1"

    is_valid_ip "$address" || return 1
    [[ "$address" == "0.0.0.0" || "$address" == "::" ]] && return 0
    ip -o address show | awk '{sub(/\/.*/, "", $4); print $4}' | grep -Fxq "$address"
}

is_valid_port() {
    [[ "$1" =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

addresses_overlap() {
    local first="$1"
    local second="$2"

    [[ "$first" == "$second" || "$first" == "*" || "$second" == "*" || \
       "$first" == "::" || "$second" == "::" ]] && return 0
    if [[ "$first" == "0.0.0.0" && "$second" != *:* ]] || \
       [[ "$second" == "0.0.0.0" && "$first" != *:* ]]; then
        return 0
    fi
    return 1
}

relay_port_in_use() {
    local protocol="$1"
    local listen_address="$2"
    local port="$3"
    local endpoint endpoints existing_address
    local -a ss_options

    if [[ "$protocol" == "tcp" ]]; then
        ss_options=(-H -ltn)
    else
        ss_options=(-H -lun)
    fi

    endpoints=$(ss "${ss_options[@]}" "sport = :$port" 2>/dev/null | awk '{print $4}') || {
        relay_error "Could not inspect $protocol listeners on port $port."
        return 2
    }
    while IFS= read -r endpoint; do
        [[ -n "$endpoint" ]] || continue
        if [[ "$endpoint" =~ ^\[(.*)\]:[0-9]+$ ]]; then
            existing_address=${BASH_REMATCH[1]}
        else
            existing_address=${endpoint%:*}
        fi
        addresses_overlap "$listen_address" "$existing_address" && return 0
    done <<< "$endpoints"
    return 1
}

verify_relay_sockets() {
    local definitions="$1"
    local name protocol listen_address listen_port network check_status attempt

    while IFS=$'\t' read -r name protocol listen_address listen_port; do
        [[ -n "$name" ]] || continue
        for network in tcp udp; do
            [[ "$protocol" == "$network" || "$protocol" == "both" ]] || continue
            check_status=1
            for attempt in {1..10}; do
                relay_port_in_use "$network" "$listen_address" "$listen_port"
                check_status=$?
                [[ "$check_status" == "0" || "$check_status" == "2" ]] && break
                sleep 0.2
            done
            if [[ "$check_status" != "0" ]]; then
                relay_error "Relay $name did not open the requested $network socket on $listen_address:$listen_port."
                return 1
            fi
        done
    done < <(jq -r '.[] | select(.enabled == true) | [.name, .protocol, .listen_address, .listen_port] | @tsv' "$definitions")
}

relay_definition_conflicts() {
    local protocol="$1"
    local listen_address="$2"
    local port="$3"

    jq -e --arg protocol "$protocol" --arg listen_address "$listen_address" \
        --argjson port "$port" '
        def address_overlap($first; $second):
            $first == $second or
            $first == "::" or $second == "::" or
            ($first == "0.0.0.0" and ($second | contains(":") | not)) or
            ($second == "0.0.0.0" and ($first | contains(":") | not));
        any(.[];
            .enabled == true and
            .listen_port == $port and
            (.protocol == "both" or $protocol == "both" or .protocol == $protocol) and
            address_overlap(.listen_address; $listen_address)
        )
    ' "$RELAY_DEFINITIONS" >/dev/null
}

warn_sensitive_port() {
    local port="$1"
    local confirm

    if [[ "$port" == "22" ]]; then
        printf 'Warning: port 22 is commonly used by SSH and may lock out remote access.\n'
        read -r -p "Continue with sensitive port 22? [y/N] " confirm
        [[ "$confirm" =~ ^[Yy]$ ]]
        return
    fi
    return 0
}

check_easytier_route() {
    local destination_ip="$1"
    local kernel_route

    if ! systemctl is-active --quiet easymesh.service; then
        printf 'Warning: EasyMesh is not active; the EasyTier route could not be confirmed.\n'
        return 1
    fi

    kernel_route=$(ip route get "$destination_ip" 2>/dev/null) || {
        printf 'Warning: the kernel has no route to %s.\n' "$destination_ip"
        return 1
    }

    printf 'Kernel route to %s while EasyMesh is active: %s\n' "$destination_ip" "$kernel_route"
}

relay_add_failed() {
    printf '\nRelay was not saved because %s\n' "$1"
}

add_relay() {
    local name protocol listen_address listen_port destination_ip destination_port
    local temp_dir temp_definitions result conflict_status confirm network

    resolve_xray_asset >/dev/null || {
        relay_error "Unsupported Xray architecture: $(uname -m)"
        relay_add_failed "this server architecture is unsupported."
        return 1
    }
    ensure_relay_dependencies && ensure_relay_storage || {
        relay_add_failed "required local tools or storage could not be prepared."
        return 1
    }

    read -r -p "Relay name: " name || {
        relay_add_failed "input ended before the relay was confirmed."
        return 1
    }
    if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; then
        relay_error "Name must use 1-64 letters, numbers, dots, underscores, or hyphens."
        relay_add_failed "the relay name was invalid."
        return 1
    fi
    if jq -e --arg name "$name" 'any(.[]; .name == $name)' "$RELAY_DEFINITIONS" >/dev/null; then
        relay_error "A relay named $name already exists."
        relay_add_failed "the relay name is already in use."
        return 1
    fi

    printf '%s\n' \
        'tcp: normal TCP-based VLESS, VMess, Trojan, Reality, WebSocket, and similar transports.' \
        'udp: direct UDP forwarding only.' \
        'both: creates separate TCP and UDP listeners on the same numerical port.'
    read -r -p "Protocol [tcp/udp/both] (default: tcp): " protocol || {
        relay_add_failed "input ended before the relay was confirmed."
        return 1
    }
    protocol=${protocol:-tcp}
    case "$protocol" in
        tcp|udp|both) ;;
        *) relay_error "Protocol must be tcp, udp, or both."; relay_add_failed "the protocol was invalid."; return 1 ;;
    esac

    read -r -p "Listen address [0.0.0.0]: " listen_address || {
        relay_add_failed "input ended before the relay was confirmed."
        return 1
    }
    listen_address=${listen_address:-0.0.0.0}
    is_valid_listen_address "$listen_address" || {
        relay_error "Listen address must be 0.0.0.0, ::, or an IP assigned to this server."
        relay_add_failed "the listen address was invalid."
        return 1
    }

    read -r -p "Listen port: " listen_port || {
        relay_add_failed "input ended before the relay was confirmed."
        return 1
    }
    is_valid_port "$listen_port" || {
        relay_error "Listen port must be numeric and between 1 and 65535."
        relay_add_failed "the listen port was invalid."
        return 1
    }
    listen_port=$((10#$listen_port))
    warn_sensitive_port "$listen_port" || {
        relay_add_failed "the sensitive-port confirmation was cancelled."
        return 1
    }

    for network in tcp udp; do
        [[ "$protocol" == "$network" || "$protocol" == "both" ]] || continue
        if relay_definition_conflicts "$network" "$listen_address" "$listen_port"; then
            relay_error "An enabled relay already uses $network port $listen_port on an overlapping address."
            relay_add_failed "the requested $network listener conflicts with an existing relay."
            return 1
        fi
        relay_port_in_use "$network" "$listen_address" "$listen_port"
        conflict_status=$?
        if [[ "$conflict_status" == "0" ]]; then
            relay_error "${network^^} port $listen_port is already in use on an overlapping address."
            relay_add_failed "the requested $network listener is already in use."
            return 1
        elif [[ "$conflict_status" == "2" ]]; then
            relay_add_failed "the $network listener conflict check failed."
            return 1
        fi
    done

    read -r -p "Destination IP: " destination_ip || {
        relay_add_failed "input ended before the relay was confirmed."
        return 1
    }
    is_valid_ip "$destination_ip" || {
        relay_error "Destination must be a valid IP address."
        relay_add_failed "the destination IP was invalid."
        return 1
    }
    read -r -p "Destination port: " destination_port || {
        relay_add_failed "input ended before the relay was confirmed."
        return 1
    }
    is_valid_port "$destination_port" || {
        relay_error "Destination port must be numeric and between 1 and 65535."
        relay_add_failed "the destination port was invalid."
        return 1
    }
    destination_port=$((10#$destination_port))

    printf '\nRelay summary:\n'
    printf '  Name: %s\n  Protocol: %s\n  Public listener: %s:%s\n  Destination: %s:%s\n' \
        "$name" "$protocol" "$listen_address" "$listen_port" "$destination_ip" "$destination_port"
    read -r -p "Add this relay? [y/N] " confirm || confirm=""
    [[ "$confirm" =~ ^[Yy]$ ]] || {
        relay_add_failed "confirmation was cancelled."
        return 1
    }

    check_easytier_route "$destination_ip" || true
    make_relay_temp_dir temp_dir || {
        relay_add_failed "temporary configuration staging failed."
        return 1
    }
    temp_definitions="$temp_dir/relays.json"
    if ! jq \
        --arg name "$name" \
        --arg protocol "$protocol" \
        --arg listen_address "$listen_address" \
        --argjson listen_port "$listen_port" \
        --arg destination_ip "$destination_ip" \
        --argjson destination_port "$destination_port" \
        '. + [{name: $name, protocol: $protocol, listen_address: $listen_address,
               listen_port: $listen_port, destination_ip: $destination_ip,
               destination_port: $destination_port, enabled: true}]' \
        "$RELAY_DEFINITIONS" > "$temp_definitions"; then
        safe_remove_temp_dir "$temp_dir"
        relay_add_failed "the candidate relay definition could not be generated."
        return 1
    fi

    apply_relay_definitions "$temp_definitions"
    result=$?
    safe_remove_temp_dir "$temp_dir"
    if [[ "$result" != "0" ]]; then
        case "$RELAY_APPLY_FAILURE" in
            xray_cancelled) relay_add_failed "the isolated Xray installation was cancelled." ;;
            xray_install_failed) relay_add_failed "the Xray download or integrity verification failed." ;;
            config_rejected) relay_add_failed "the candidate Xray configuration was rejected." ;;
            service_rollback) printf '\nRelay configuration was rolled back because the service or requested listener failed to start.\n' ;;
            *) relay_add_failed "the transactional configuration update failed." ;;
        esac
        return 1
    fi

    printf '\nRelay added successfully.\n'
    printf 'Name: %s\nPublic listener: %s:%s/%s\nDestination: %s:%s\nService: active\n' \
        "$name" "$listen_address" "$listen_port" "$protocol" "$destination_ip" "$destination_port"
}

list_relays() {
    ensure_relay_dependencies && ensure_relay_storage || return 1
    if [[ $(jq 'length' "$RELAY_DEFINITIONS") -eq 0 ]]; then
        printf 'No relays are configured.\n'
        printf 'Select "Add Relay" to create the first relay.\n'
        return 0
    fi

    printf '%-16s %-9s %-24s %-24s %s\n' \
        'Name' 'Protocol' 'Public Listener' 'Destination' 'Status'
    jq -r '.[] | [.name, .protocol, (.listen_address + ":" + (.listen_port | tostring)),
        (.destination_ip + ":" + (.destination_port | tostring)),
        (if .enabled then "Enabled" else "Disabled" end)] | @tsv' "$RELAY_DEFINITIONS" |
        while IFS=$'\t' read -r name protocol listener destination status; do
            printf '%-16s %-9s %-24s %-24s %s\n' \
                "$name" "$protocol" "$listener" "$destination" "$status"
        done
}

remove_relay() {
    local confirm name temp_dir temp_definitions result

    ensure_relay_dependencies && ensure_relay_storage || return 1
    list_relays
    read -r -p "Relay name to remove: " name
    if ! jq -e --arg name "$name" 'any(.[]; .name == $name)' "$RELAY_DEFINITIONS" >/dev/null; then
        relay_error "Relay not found: $name"
        return 1
    fi
    read -r -p "Remove relay $name? [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || return 0

    make_relay_temp_dir temp_dir || return 1
    temp_definitions="$temp_dir/relays.json"
    jq --arg name "$name" 'map(select(.name != $name))' \
        "$RELAY_DEFINITIONS" > "$temp_definitions" || {
        safe_remove_temp_dir "$temp_dir"
        return 1
    }
    apply_relay_definitions "$temp_definitions"
    result=$?
    safe_remove_temp_dir "$temp_dir"
    return "$result"
}

relay_status() {
    if [[ ! -f "$RELAY_SERVICE_FILE" ]]; then
        printf '%s is not installed.\n' "$RELAY_SERVICE_NAME"
        return 0
    fi
    systemctl status "$RELAY_SERVICE_NAME" --no-pager
}

restart_relay() {
    local enabled_count

    if [[ ! -f "$RELAY_SERVICE_FILE" ]]; then
        relay_error "$RELAY_SERVICE_NAME is not installed."
        return 1
    fi
    if [[ ! -x "$RELAY_BINARY" || ! -f "$RELAY_CONFIG" ]] || \
       ! "$RELAY_BINARY" run -test -config "$RELAY_CONFIG" >/dev/null 2>&1; then
        relay_error "Relay configuration validation failed; service was not restarted."
        return 1
    fi
    if [[ ! -f "$RELAY_DEFINITIONS" ]] || ! validate_relay_definitions_file "$RELAY_DEFINITIONS"; then
        relay_error "Relay definitions are missing or invalid; service was not restarted."
        return 1
    fi
    enabled_count=$(jq '[.[] | select(.enabled == true)] | length' "$RELAY_DEFINITIONS") || return 1
    if [[ "$enabled_count" == "0" ]]; then
        relay_error "No enabled relays exist; the relay service remains stopped."
        return 1
    fi
    systemctl restart "$RELAY_SERVICE_NAME" && \
        systemctl is-active "$RELAY_SERVICE_NAME" && \
        verify_relay_process_name && verify_relay_sockets "$RELAY_DEFINITIONS"
}

view_relay_logs() {
    journalctl -u "$RELAY_SERVICE_NAME" -n 100 --no-pager
}

show_xray_version() {
    if [[ ! -x "$RELAY_BINARY" ]]; then
        printf 'Isolated relay Xray is not installed.\n'
        return 0
    fi
    "$RELAY_BINARY" version
}

xray_status_install() {
    local confirm temp_dir version

    if [[ -x "$RELAY_BINARY" ]]; then
        version=$(get_installed_xray_version || true)
        printf 'Isolated relay Xray is installed: v%s\n' "${version:-unknown}"
        printf 'Runtime binary: %s\n' "$RELAY_BINARY"
        return 0
    fi

    printf 'Isolated relay Xray is not installed.\n'
    printf 'This component uses only Behify-owned paths below %s.\n' "$RELAY_ROOT"
    printf 'Existing panel and system Xray installations will not be touched.\n'
    read -r -p "Download and install the stable official Xray release? [y/N] " confirm || confirm=""
    [[ "$confirm" =~ ^[Yy]$ ]] || {
        printf 'Isolated Xray installation cancelled.\n'
        return 0
    }

    resolve_xray_asset >/dev/null && ensure_relay_dependencies && fetch_latest_xray_release || return 1
    make_relay_temp_dir temp_dir || return 1
    download_verified_xray_candidate "$temp_dir" || {
        safe_remove_temp_dir "$temp_dir"
        return 1
    }
    if [[ -f "$RELAY_CONFIG" ]] && \
       ! "$XRAY_CANDIDATE_BINARY" run -test -config "$RELAY_CONFIG" >/dev/null 2>&1; then
        relay_error "Verified Xray candidate rejected the existing relay configuration."
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi
    begin_relay_critical_section
    if ! activate_xray_candidate "$XRAY_LATEST_VERSION" "$XRAY_CANDIDATE_BINARY"; then
        end_relay_critical_section
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi
    end_relay_critical_section
    safe_remove_temp_dir "$temp_dir"
    version=$(get_installed_xray_version || true)
    printf 'Isolated relay Xray installed successfully: v%s\n' "${version:-unknown}"
}

relay_diagnostics() {
    local definitions_status="missing" config_status="missing"

    [[ -f "$RELAY_DEFINITIONS" ]] && definitions_status="invalid"
    [[ -f "$RELAY_DEFINITIONS" ]] && jq empty "$RELAY_DEFINITIONS" >/dev/null 2>&1 && definitions_status="valid"
    [[ -f "$RELAY_CONFIG" ]] && config_status="invalid"
    [[ -f "$RELAY_CONFIG" ]] && jq empty "$RELAY_CONFIG" >/dev/null 2>&1 && config_status="valid"
    printf 'Architecture: %s\n' "$(uname -m)"
    printf 'Relay runtime: %s\n' "$RELAY_BINARY"
    printf 'Legacy isolated Xray: %s\n' "$RELAY_LEGACY_XRAY_BINARY"
    printf 'Definitions: %s (%s)\n' "$RELAY_DEFINITIONS" "$definitions_status"
    printf 'Generated config: %s (%s)\n' "$RELAY_CONFIG" "$config_status"
    printf 'Service unit: %s\n' "$RELAY_SERVICE_FILE"
    if [[ -f "$RELAY_SERVICE_FILE" ]]; then
        systemctl show "$RELAY_SERVICE_NAME" -p ActiveState -p SubState -p MainPID -p NRestarts --no-pager
    else
        printf 'Service: not installed\n'
    fi
    if [[ -d "$RELAY_SERVICE_DROPIN_DIR" ]]; then
        find "$RELAY_SERVICE_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print \
            2>/dev/null | sed 's/^/Service drop-in: /'
    fi
    if [[ -e /relays.json ]]; then
        printf 'Warning: unexpected /relays.json exists. It was not removed because ownership cannot be proven.\n'
    fi
    if [[ -e /config.json ]]; then
        printf 'Warning: unexpected /config.json exists. It was not removed because ownership cannot be proven.\n'
    fi
}

get_installed_xray_version() {
    get_relay_runtime_version "$RELAY_BINARY"
}

check_xray_update() {
    local installed latest

    resolve_xray_asset >/dev/null || {
        relay_error "Unsupported Xray architecture: $(uname -m)"
        return 1
    }
    ensure_relay_dependencies || return 1
    fetch_latest_xray_release || return 1
    latest=${XRAY_LATEST_VERSION#v}
    installed=$(get_installed_xray_version || true)
    printf 'Installed Xray: %s\n' "${installed:-not installed}"
    printf 'Latest Xray: %s\n' "$latest"
    if [[ "$installed" == "$latest" ]]; then
        printf 'The isolated relay Xray is up to date.\n'
    else
        printf 'An isolated relay Xray update is available.\n'
    fi
    return 0
}

update_xray() {
    local installed latest service_was_active=0
    local confirm temp_dir backup_dir timestamp candidate_config rollback_failed=0

    resolve_xray_asset >/dev/null || {
        relay_error "Unsupported Xray architecture: $(uname -m)"
        return 1
    }
    ensure_relay_dependencies || return 1
    fetch_latest_xray_release || return 1
    installed=$(get_installed_xray_version || true)
    latest=${XRAY_LATEST_VERSION#v}
    printf 'Installed Xray: %s\n' "${installed:-not installed}"
    printf 'Latest Xray: %s\n' "$latest"
    if [[ "$installed" == "$latest" ]]; then
        printf 'The isolated relay Xray is already up to date.\n'
        return 0
    fi
    read -r -p "Install isolated Xray $XRAY_LATEST_VERSION? [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || return 0

    make_relay_temp_dir temp_dir || return 1
    download_verified_xray_candidate "$temp_dir" || {
        safe_remove_temp_dir "$temp_dir"
        return 1
    }

    candidate_config="$temp_dir/config.json"
    if [[ -f "$RELAY_CONFIG" ]]; then
        cp "$RELAY_CONFIG" "$candidate_config" || {
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
    elif [[ -f "$RELAY_DEFINITIONS" ]]; then
        validate_relay_definitions_file "$RELAY_DEFINITIONS" || {
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
        generate_xray_config "$RELAY_DEFINITIONS" "$candidate_config" || {
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
    else
        printf '[]\n' > "$temp_dir/relays.json"
        generate_xray_config "$temp_dir/relays.json" "$candidate_config" || {
            safe_remove_temp_dir "$temp_dir"
            return 1
        }
    fi
    if ! jq empty "$candidate_config" || \
       ! "$XRAY_CANDIDATE_BINARY" run -test -config "$candidate_config" >/dev/null 2>&1; then
        relay_error "Verified Xray candidate rejected the current relay configuration."
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi

    systemctl is-active --quiet "$RELAY_SERVICE_NAME" && service_was_active=1
    timestamp=$(date +%Y%m%d-%H%M%S)
    backup_dir="$RELAY_BACKUPS_DIR/$timestamp"
    while [[ -e "$backup_dir" ]]; do
        sleep 1
        timestamp=$(date +%Y%m%d-%H%M%S)
        backup_dir="$RELAY_BACKUPS_DIR/$timestamp"
    done
    install -d -m 0700 "$backup_dir" || {
        safe_remove_temp_dir "$temp_dir"
        return 1
    }
    if ! backup_relay_runtime_state "$backup_dir/runtime"; then
        relay_error "Could not back up the installed relay runtime."
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi
    if [[ -f "$RELAY_DEFINITIONS" ]] && ! cp "$RELAY_DEFINITIONS" "$backup_dir/relays.json"; then
        relay_error "Could not back up relay definitions."
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi
    if [[ -f "$RELAY_CONFIG" ]] && ! cp "$RELAY_CONFIG" "$backup_dir/config.json"; then
        relay_error "Could not back up relay config."
        safe_remove_temp_dir "$temp_dir"
        return 1
    fi

    begin_relay_critical_section
    if ! activate_xray_candidate "$XRAY_LATEST_VERSION" "$XRAY_CANDIDATE_BINARY"; then
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        return 1
    fi

    if [[ "$service_was_active" == "1" ]] && \
       { ! systemctl restart "$RELAY_SERVICE_NAME" || \
         ! systemctl is-active --quiet "$RELAY_SERVICE_NAME" || \
         ! verify_relay_process_name || \
         { [[ -f "$RELAY_DEFINITIONS" ]] && \
           { ! validate_relay_definitions_file "$RELAY_DEFINITIONS" || \
             ! verify_relay_sockets "$RELAY_DEFINITIONS"; }; }; }; then
        relay_error "Updated Xray failed to start. Restoring the previous release."
        restore_relay_runtime_state "$backup_dir/runtime" || rollback_failed=1
        if [[ -f "$backup_dir/relays.json" ]] && \
           ! install -m 0600 "$backup_dir/relays.json" "$RELAY_DEFINITIONS"; then
            rollback_failed=1
        fi
        if [[ -f "$backup_dir/config.json" ]] && \
           ! install -m 0600 "$backup_dir/config.json" "$RELAY_CONFIG"; then
            rollback_failed=1
        fi
        if [[ "$rollback_failed" == "0" && -x "$RELAY_BINARY" ]]; then
            if systemctl restart "$RELAY_SERVICE_NAME" >/dev/null 2>&1; then
                printf 'Previous Xray release restored and restarted.\n'
            else
                relay_error "Previous Xray was restored, but the relay service did not restart."
                rollback_failed=1
            fi
        fi
        [[ "$rollback_failed" == "0" ]] || relay_error "Automatic Xray rollback was incomplete. Backup: $backup_dir"
        safe_remove_temp_dir "$temp_dir"
        end_relay_critical_section
        return 1
    fi

    safe_remove_temp_dir "$temp_dir"
    end_relay_critical_section
    printf 'Isolated relay Xray updated to %s.\n' "$XRAY_LATEST_VERSION"
}

remove_relay_component() {
    local confirm
    local unit_changed=0 dropin_changed=0 canonical_neutral=0

    printf 'This removes only the Behify relay service, relay configs, and isolated Xray.\n'
    read -r -p "Remove the Behify relay component? [y/N] " confirm || confirm=""
    [[ "$confirm" =~ ^[Yy]$ ]] || return 0

    if [[ -f "$RELAY_SERVICE_FILE" ]] && ! relay_service_is_owned; then
        relay_error "The service file at $RELAY_SERVICE_FILE is not owned by this relay manager. Removal aborted."
        return 1
    fi
    if [[ ! -f "$RELAY_SERVICE_FILE" ]] && \
       { systemctl is-active --quiet "$RELAY_SERVICE_NAME" || systemctl is-enabled --quiet "$RELAY_SERVICE_NAME"; }; then
        relay_error "A loaded service named $RELAY_SERVICE_NAME exists, but ownership cannot be verified. Removal aborted."
        return 1
    fi
    relay_service_uses_neutral_runtime && canonical_neutral=1
    if relay_service_is_owned; then
        systemctl disable --now "$RELAY_SERVICE_NAME" || {
            relay_error "Could not stop and disable $RELAY_SERVICE_NAME. Removal aborted."
            return 1
        }
        if [[ -f "$RELAY_SERVICE_FILE" ]]; then
            rm -f "$RELAY_SERVICE_FILE" || return 1
            unit_changed=1
        fi
    fi
    if [[ "$canonical_neutral" == "1" ]] && known_neutral_dropin_matches; then
        rm -f "$RELAY_KNOWN_NEUTRAL_DROPIN" || return 1
        dropin_changed=1
    fi
    [[ "$unit_changed" == "0" && "$dropin_changed" == "0" ]] || systemctl daemon-reload || return 1
    safe_remove_managed_tree "$RELAY_BIN_DIR" || return 1
    safe_remove_managed_tree "$RELAY_RELEASES_DIR" || return 1
    safe_remove_managed_tree "$RELAY_BACKUPS_DIR" || return 1
    safe_remove_managed_tree "$RELAY_LEGACY_XRAY_ROOT" || return 1
    safe_remove_managed_tree "$RELAY_CONFIG_DIR" || return 1
    if [[ -d "$RELAY_SERVICE_DROPIN_DIR" ]] && \
       find "$RELAY_SERVICE_DROPIN_DIR" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
        printf 'Administrator-created relay service drop-ins were preserved in %s.\n' "$RELAY_SERVICE_DROPIN_DIR"
    fi
    printf 'Behify relay component removed. Existing Xray and panel installations were not touched.\n'
}

get_relay_dashboard_count() {
    if [[ ! -f "$RELAY_DEFINITIONS" ]]; then
        printf '0\n'
    elif command -v jq >/dev/null 2>&1 && jq empty "$RELAY_DEFINITIONS" >/dev/null 2>&1; then
        jq 'length' "$RELAY_DEFINITIONS"
    else
        printf 'unknown\n'
    fi
}

get_relay_dashboard_service() {
    if [[ ! -f "$RELAY_SERVICE_FILE" ]]; then
        printf 'Not installed\n'
    elif systemctl is-active --quiet "$RELAY_SERVICE_NAME"; then
        printf 'Active\n'
    else
        printf 'Inactive\n'
    fi
}

display_relay_menu() {
    local xray_label relay_count service_label version

    clear
    version=$(get_installed_xray_version || true)
    [[ -n "$version" ]] && xray_label="Installed v$version" || xray_label="Not installed"
    relay_count=$(get_relay_dashboard_count)
    service_label=$(get_relay_dashboard_service)

    relay_color '1;36' 'Behify Relay / Port Routing'
    printf '+--------------------------------------+\n'
    relay_box_line "Xray: $xray_label"
    relay_box_line "Relays: $relay_count"
    relay_box_line "Service: $service_label"
    printf '+--------------------------------------+\n'
    relay_color '1;36' 'Menu options:'
    printf '%s\n' \
        '  1. Add Relay' \
        '  2. List Relays' \
        '  3. Remove Relay' \
        '  4. Relay Status' \
        '  5. Restart Relay' \
        '  6. View Relay Logs' \
        '  7. Xray Status / Install' \
        '  8. Update Xray' \
        '  9. Diagnostics' \
        ' 10. Remove Relay Component' \
        '  0. Back'
}

if [[ "$RELAY_SOURCE_ONLY" == "1" ]]; then
    return 0 2>/dev/null || exit 0
fi

if [[ "${1:-}" == "--migrate-runtime" ]]; then
    migrate_legacy_relay_runtime
    exit $?
elif [[ $# -gt 0 ]]; then
    relay_error "Unknown relay-manager argument: $1"
    exit 1
fi

migrate_legacy_relay_runtime || {
    relay_error "Relay management stopped because the neutral runtime migration did not complete safely."
    exit 1
}

while true; do
    display_relay_menu
    if ! read -r -p "Select an option: " relay_choice; then
        printf '\nLeaving relay manager.\n'
        exit 0
    fi
    case "$relay_choice" in
        1) add_relay; relay_pause ;;
        2) list_relays; relay_pause ;;
        3) remove_relay; relay_pause ;;
        4) relay_status; relay_pause ;;
        5) restart_relay; relay_pause ;;
        6) view_relay_logs; relay_pause ;;
        7) xray_status_install; relay_pause ;;
        8) update_xray; relay_pause ;;
        9) relay_diagnostics; relay_pause ;;
        10) remove_relay_component; relay_pause ;;
        0) exit 0 ;;
        *) printf 'Invalid option.\n'; relay_pause ;;
    esac
done
